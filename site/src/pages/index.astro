---
import '@fontsource-variable/recursive/mono.css';
import '../styles/tokens.css';

// Output on this page comes from a real run of hledger-flow and hledger on
// the statement and rules shown. Rerun them when the output format changes.
const title = 'hledger-flow: rebuild your hledger journals from your original statements';
const description =
  'A command-line workflow for hledger. It files your statements in a fixed folder layout, keeps them as permanent input, and rebuilds reproducible, auditable journals from them.';

// The river map is too detailed for narrow screens, so it loads only where
// it's shown. Cropped from a 4096px original, with the title lettered into the
// empty frame in Big Caslon; regenerate all widths together.
const mapWidths = [1136, 1704, 2272];
const mapSrcset = (ext: string) =>
  mapWidths.map((w) => `/images/statement-river-${w}.${ext} ${w}w`).join(', ');
const mapSizes = '(min-width: 76rem) 71rem, calc(100vw - 5rem)';
const mapMedia = '(min-width: 64rem)';

const tree = [
  { path: 'all-years.journal', note: 'Point LEDGER_FILE here', href: '/go/set-ledger-file/', made: true },
  { path: 'directives.journal', note: 'Optional: commodity formats, account types', href: '/reference/directives/' },
  { path: 'prices/2025/prices.journal', note: 'Optional: market prices for the year', href: '/reference/price-files/' },
  { path: 'import/', note: '' },
  { path: '  mybank.rules', note: 'Default CSV rules for mybank', href: '/go/rules-files/' },
  { path: '  john/', note: 'Owner' },
  { path: '    _manual_/2025/post-import.journal', note: 'Transactions without a statement', href: '/reference/manual-journals/' },
  { path: '    mybank/', note: 'Bank' },
  { path: '      checking/', note: 'Account' },
  { path: '        1-in/2025/2025-03.csv', note: 'The statement, as downloaded', href: '/go/input-files/' },
  { path: '        preprocess', note: 'Optional: clean the CSV before the rules run', href: '/go/preprocess-script/' },
  { path: '        3-journal/2025/2025-03.journal', note: 'One journal per statement', made: true },
  { path: '        2025-include.journal', note: 'Includes for the year, at every level', made: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://hledger-flow.github.io/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Follow the theme chosen in the docs (Starlight stores it here).
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="wordmark" href="/">hledger-flow</a>
      <nav aria-label="Main">
        <a href="/quickstart/">Quick start</a>
        <a href="/tutorial/">Tutorial</a>
        <a href="/reference/status/">Reference</a>
        <a href="https://github.com/apauley/hledger-flow">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title"><span>Keep every statement.</span> <span>Rebuild your journals from them.</span></h1>

        <figure class="map" aria-labelledby="map-caption">
          <picture>
            <source media={mapMedia} type="image/avif" srcset={mapSrcset('avif')} sizes={mapSizes} />
            <source media={mapMedia} type="image/webp" srcset={mapSrcset('webp')} sizes={mapSizes} />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              width="2272"
              height="1583"
              fetchpriority="high"
              alt="An engraved river map titled hledger-flow, a workflow for hledger. Streams from a bank statement, brokerage trades and a wallet export cross a dashed line marked “On your computer”, pass signposts for their import folders and meet at a wall marked hledger-flow import. The water runs into an open ledger titled “Your combined ledger, all-years.journal”."
            />
          </picture>
          <figcaption id="map-caption">
            Each statement stays in its account’s <code>1-in/</code> folder. <code>hledger-flow import</code> converts
            it to a journal and links every journal into <code>all-years.journal</code>, the file hledger reads.
          </figcaption>
        </figure>

        <div class="hero-copy">
          <p class="lead">
            hledger-flow is a command-line workflow for <a href="https://hledger.org/">hledger</a>, the plain-text
            accounting tool. hledger keeps your accounts in journals: human-readable text files you can open in any
            editor, in a format that hledger reads and that <a href="/guides/ledger/">Ledger</a> and other plain-text
            accounting tools largely share.
          </p>
          <p class="lead">
            hledger-flow is opinionated about where files live. You save each statement, exactly as your bank issued
            it, in a folder for its owner, institution, account and year. <code>hledger-flow import</code> converts
            each one with your hledger rules, or a script for formats rules can’t read, and links the journals
            through <code>all-years.journal</code>. The statements stay as permanent input, so every journal can be
            rebuilt from its source and every entry traced to the statement it came from.
            <a href="#choose-title">How does it compare with plain hledger?</a>
          </p>
          <div class="actions">
            <a class="button" href="/quickstart/">Read the quick start</a>
            <div class="command">
              <code id="brew">brew install ferntrail/tap/hledger-flow</code>
              <button type="button" data-copy="brew" aria-label="Copy the Homebrew install command">Copy</button>
            </div>
          </div>
        </div>

        <figure class="sheet" aria-labelledby="sheet-caption">
          <ol>
            <li style="--step: 0">
              <span class="where yours">1-in/2025/2025-03.csv</span>
              <pre>2025-03-14,City Rail monthly pass,-62.50</pre>
            </li>
            <li style="--step: 1">
              <span class="where yours">import/mybank.rules</span>
              <pre>fields date, description, amount
currency $
account1 assets:john:mybank:checking
account2 expenses:misc

if City Rail
  account2 expenses:transport</pre>
            </li>
            <li style="--step: 2">
              <span class="where made">3-journal/2025/2025-03.journal</span>
              <pre>2025-03-14 City Rail monthly pass
    assets:john:mybank:checking         <span class="neg">$-62.50</span>
    expenses:transport                   $62.50</pre>
            </li>
            <li style="--step: 3">
              <span class="where made">all-years.journal, read via LEDGER_FILE</span>
              <pre>include import/all-years.journal
  include 2025-include.journal
    one per owner, bank and account
      include 3-journal/2025/2025-03.journal</pre>
            </li>
            <li style="--step: 4">
              <span class="where yours">hledger bal expenses</span>
              <pre>              $62.50  expenses:transport
--------------------
              $62.50</pre>
            </li>
          </ol>
          <figcaption id="sheet-caption">One March purchase, from the downloaded CSV through the generated includes to an expense report.</figcaption>
        </figure>
      </section>

      <section aria-labelledby="account-title">
        <div class="prose">
          <h2 id="account-title">A place for the account your other tools leave out</h2>
          <p>
            If your finance app doesn’t support a particular broker or wallet, that account disappears from your
            reports. In plain text, you can always record it. Read a trade history with hledger’s CSV rules, write a
            script for an unusual export, or enter a loan to a friend by hand in a
            <a href="/reference/manual-journals/">manual journal</a>. All three appear on the same balance sheet. To see
            investments at market value, add the <a href="/reference/price-files/">prices</a> you want hledger to use.
          </p>
          <p>
            hledger-flow makes that work repeatable. Keep the original statements, exactly as your institutions issued
            them, and the rules that read them. Years later, in a tax audit say, you can show where any transaction came
            from. When you improve a category, run <code>hledger-flow import</code> again and every statement that uses
            the rule is converted again, in every year, with no search-and-replace through old entries. If you keep the
            generated journals in Git, you can review which postings changed before you commit.
          </p>
        </div>
      </section>

      <section class="rebuild" aria-labelledby="rebuild-title">
        <div class="prose">
          <h2 id="rebuild-title">Change a rule, rebuild every year</h2>
          <p>
            City Rail purchases have been landing in <code>expenses:misc</code>. Add a rule to
            <code>import/mybank.rules</code> and run <code>hledger-flow import</code> from the ledger root. Every City
            Rail purchase, in every year you’ve imported, moves to transport.
          </p>
        </div>
        <div class="diffs">
          <figure>
            <figcaption><code>import/mybank.rules</code></figcaption>
            <pre><span class="ctx"> account1 assets:john:mybank:checking
 account2 expenses:misc</span>
<span class="add">+
+if City Rail
+  account2 expenses:transport</span></pre>
          </figure>
          <figure>
            <figcaption><code>git diff -- import/</code></figcaption>
            <pre><span class="ctx"> 2025-03-14 City Rail monthly pass
     assets:john:mybank:checking         $-62.50</span>
<span class="del">-    expenses:misc                        $62.50</span>
<span class="add">+    expenses:transport                   $62.50</span></pre>
          </figure>
        </div>
        <p class="prose after">
          Handwritten transactions live in <a href="/reference/manual-journals/">manual journals</a>, so a rebuild never
          touches them.
        </p>
      </section>

      <section aria-labelledby="private-title">
        <div class="prose">
          <h2 id="private-title">The combined view belongs to you</h2>
          <p>
            hledger and hledger-flow run on your computer. You can produce a household balance sheet without connecting
            your bank to your broker or uploading either statement to an aggregation service. Public blockchain
            transactions remain public. The link between a wallet, your other accounts and your notes exists only in
            your own files.
          </p>
        </div>
      </section>

      <section class="layout" aria-labelledby="layout-title">
        <div class="prose">
          <h2 id="layout-title">Where statements and journals live</h2>
          <p>
            The folders tell hledger-flow who owns an account, where it’s held and which year you filed it under.
            The statement and its generated journal share a filename stem, so you can find the source of an entry.
            You add the statements, rules and manual journals. hledger-flow writes the rest, so you can delete every
            generated file and get the same ledger back.
          </p>
          <p class="legend"><span class="yours">Ink</span> marks the files you write. <span class="made">Pencil</span> marks generated files.</p>
        </div>
        <ul class="tree">
          {
            tree.map((row) => (
              <li class={row.made ? 'made' : 'yours'}>
                <code>{row.path}</code>
                {row.href ? <a href={row.href}>{row.note}</a> : <span>{row.note}</span>}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="choose" aria-labelledby="choose-title">
        <div class="prose">
          <h2 id="choose-title">hledger-flow or plain hledger?</h2>
          <p>
            There are many ways to keep your finances with hledger, and
            <a href="https://hledger.org/workflows.html">hledger’s workflows page</a> describes them. Three of them handle
            bank statements in quite different ways.
          </p>
        </div>
        <div class="columns">
          <div>
            <h3><code>hledger import</code></h3>
            <ul role="list">
              <li>Your journal is the primary record.</li>
              <li>You classify, split and annotate entries by editing the journal.</li>
              <li>A better rule changes future imports only.</li>
              <li>
                Overlapping downloads are fine. hledger skips entries it has already imported, as long as their
                dates and same-day order stay stable.
              </li>
            </ul>
            <p><a href="https://hledger.org/hledger.html#import">How hledger import works</a></p>
          </div>
          <div>
            <h3>Read the CSV directly</h3>
            <ul role="list">
              <li>The CSV files are the record. Nothing is generated.</li>
              <li>You classify by editing the rules.</li>
              <li>A better rule applies the next time hledger reads the file.</li>
              <li>
                Suits a few files you name yourself, as in <code>hledger -f checking.csv bal</code>. The hledger
                1.99 previews can also <code>include</code> a CSV in a journal.
              </li>
            </ul>
            <p><a href="https://hledger.org/hledger.html#csv">Reading CSV with hledger</a></p>
          </div>
          <div>
            <h3>hledger-flow</h3>
            <ul role="list">
              <li>The original statements are the primary record. Journals are rebuilt from them.</li>
              <li>You classify by editing rules files.</li>
              <li>A better rule rebuilds every journal that uses it, in every year.</li>
              <li>
                A fixed folder for each owner, institution, account and year keeps years of statements maintainable.
                An account’s statements mustn’t overlap, or a purchase appears twice.
              </li>
            </ul>
            <p><a href="/quickstart/">Quick start</a></p>
          </div>
        </div>
        <p class="prose after">
          Choose <code>hledger import</code> if your journal is your primary record and you want to edit it by hand.
          Choose hledger-flow if you want to generate your journals from statements exactly as they came from the
          source, classify by editing rules, and keep years of files in a structure that stays maintainable and
          auditable.
        </p>
        <p class="prose after">
          hledger-flow grew out of scripts written while using Dmitry Astapov’s Full-fledged hledger, whose wiki
          explains <a href="https://github.com/adept/full-fledged-hledger/wiki/Key-principles-and-practices">the ideas
          behind this approach</a> in depth.
        </p>
      </section>

      <section class="install" aria-labelledby="install-title">
        <h2 id="install-title">Install</h2>
        <dl>
          <div>
            <dt>Homebrew <span>Linux, macOS</span></dt>
            <dd><code>brew install ferntrail/tap/hledger-flow</code></dd>
          </div>
          <div>
            <dt>Release download <span>Linux, macOS, Windows</span></dt>
            <dd><a href="/quickstart/#download-a-release">Choose the archive for your system</a></dd>
          </div>
          <div>
            <dt>From source <span>Any platform with Stack</span></dt>
            <dd><a href="/quickstart/#build-from-source"><code>stack install</code> from a checkout</a></dd>
          </div>
        </dl>
        <p>
          Then follow the <a href="/quickstart/#import-your-first-statement">quick start</a> to import your first
          statement, or the <a href="/tutorial/">tutorial</a> for the whole story.
        </p>
      </section>
    </main>

    <footer class="bottom">
      <p>
        hledger-flow is free software under the GPL-3.0 licence, supported by
        <a href="https://ferntrail.tech/">FernTrail B.V.</a>
      </p>
      <nav aria-label="Project">
        <a href="https://github.com/apauley/hledger-flow">Source</a>
        <a href="https://github.com/apauley/hledger-flow/blob/master/ChangeLog.md">Changelog</a>
        <a href="https://hackage.haskell.org/package/hledger-flow">Hackage</a>
        <a href="https://github.com/apauley/hledger-flow/issues">Issues</a>
      </nav>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy!)?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select and copy';
          }
          setTimeout(() => (button.textContent = 'Copy'), 2000);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-text);
    font-variation-settings: var(--mono-off);
    font-size: 100%;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  code,
  pre {
    font-family: var(--font-code);
    font-variation-settings: var(--mono-on);
    font-size: 0.875em;
  }

  a {
    color: var(--link);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 2px;
  }

  h1,
  h2,
  h3 {
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0;
  }

  h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem);
    font-weight: 720;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 680;
  }

  .skip {
    position: absolute;
    left: -100vw;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--paper);
    padding: 0.5rem 0.75rem;
  }

  /* Page frame: content sits right of the red margin rule. */
  .top,
  main > section,
  .bottom {
    width: min(100% - 2rem, 71rem);
    margin-inline: auto;
  }

  @media (min-width: 48rem) {
    .top,
    main > section,
    .bottom {
      width: min(100% - 5rem, 71rem);
    }
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.25rem;
  }

  .wordmark {
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
    font-variation-settings: var(--mono-on);
  }

  .top nav,
  .bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .top nav a {
    color: var(--ink);
    text-decoration: none;
  }

  .top nav a:hover {
    text-decoration: underline;
  }

  main > section {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  main > section + section {
    border-top: 1px solid var(--rule);
  }

  .prose {
    max-width: 38rem;
  }

  .prose p,
  p.prose {
    margin-block: 1rem 0;
  }

  /* Hero */
  .hero,
  .layout,
  .diffs,
  .columns,
  .install dl > div {
    grid-template-columns: minmax(0, 1fr);
  }

  .hero {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Wide screens: the headline, the map, then the introduction in two columns. */
  @media (min-width: 64rem) {
    .hero {
      row-gap: 2.5rem;
    }

    .hero h1 {
      max-width: none;
      font-size: clamp(2.6rem, 1rem + 2.6vw, 3.4rem);
    }

    .hero h1 span {
      display: block;
    }

    .hero-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 4rem;
      align-items: start;
    }

    .hero-copy .lead {
      margin-top: 0;
    }

    .hero-copy .actions {
      grid-column: 2;
    }
  }

  .hero-copy .lead:first-child {
    margin-top: 0;
  }

  .lead + .lead {
    margin-top: 1rem;
  }

  /* The river map: a printed map laid on the pad. Wide screens only. */
  .map {
    display: none;
    margin: 0;
  }

  @media (min-width: 64rem) {
    .map {
      display: block;
    }
  }

  .map img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .map figcaption {
    margin-top: 0.75rem;
    max-width: 38rem;
    color: var(--pencil);
    font-size: 0.9375rem;
  }

  /* Dim the bright parchment so it sits on the dark pad instead of glowing. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .map img {
      filter: brightness(0.82) saturate(0.9);
    }
  }

  :root[data-theme='dark'] .map img {
    filter: brightness(0.82) saturate(0.9);
  }

  .lead code {
    white-space: nowrap;
  }

  h1 {
    font-size: clamp(2.4rem, 1.6rem + 3.2vw, 4rem);
    font-weight: 780;
    letter-spacing: -0.025em;
    line-height: 1.02;
    max-width: 19ch;
    text-wrap: balance;
  }

  .lead {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    color: var(--pencil);
    font-size: 1.125rem;
  }

  .lead a,
  .lead code {
    color: var(--ink);
  }

  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .button {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-weight: 650;
    padding: 0.7rem 1.1rem;
    border-radius: 3px;
  }

  .button:hover {
    background: var(--link);
  }

  .command {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.35rem 0.35rem 0.35rem 0.75rem;
    max-width: 100%;
  }

  .command code {
    overflow-x: auto;
    white-space: nowrap;
  }

  .command button {
    font: inherit;
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }

  /* The ledger sheet: one transaction, a row per stage. */
  .sheet {
    margin: 0;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .sheet ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sheet li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-bottom: 1px solid var(--rule);
  }

  .sheet .where {
    padding: 0.75rem 1rem 0;
    font-family: var(--font-code);
    font-variation-settings: var(--mono-on);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .sheet pre {
    margin: 0;
    padding: 0.5rem 1rem 0.9rem;
    overflow-x: auto;
    line-height: 1.55;
  }

  @media (min-width: 40rem) {
    .sheet li {
      grid-template-columns: 16.5rem minmax(0, 1fr);
    }

    .sheet .where {
      padding: 0.9rem 1rem;
      border-right: 3px double var(--margin);
    }

    .sheet pre {
      padding: 0.9rem 1rem;
    }
  }

  .sheet figcaption {
    padding: 0.75rem 1rem;
    color: var(--pencil);
    font-size: 0.9375rem;
  }

  .neg {
    color: var(--margin);
  }

  .yours {
    color: var(--ink);
    font-weight: 620;
  }

  .made {
    color: var(--pencil);
  }

  /* The one orchestrated moment: each stage is written in, in order. */
  @media (prefers-reduced-motion: no-preference) {
    .sheet li {
