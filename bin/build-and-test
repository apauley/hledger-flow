#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

for tool in stack hledger git jq python3 npm; do
    command -v "$tool" >/dev/null || { echo "Install $tool and put it on PATH before running the full suite." >&2; exit 1; }
done
python3 --version
hledger --version

stack test --interleaved-output
(cd site && npm ci --no-audit --no-fund && npm run check)
stack build hledger-flow shelltestrunner
# Keep the developer's own hledger config out of the CLI scenarios. Only the
# tests get the empty home: stack needs the real one to find its compiler.
test_home=$(mktemp -d)
trap 'rm -rf "$test_home"' EXIT
isolated=(env HOME="$test_home" XDG_CONFIG_HOME="$test_home/.config")
case "$(uname -s)" in
    MINGW*|MSYS*) stack exec -- "${isolated[@]}" shelltest --timeout=120 --shell=sh --exclude=posix-preprocess.test test/shell test/windows ;;
    *) stack exec -- "${isolated[@]}" shelltest --timeout=120 test/shell ;;
esac
bash test/release/hackage.sh
bash test/release/snap.sh
python3 test/release/reuse_master_build.py
stack install hledger-flow
