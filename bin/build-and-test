#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

for tool in stack hledger git jq python3; do
    command -v "$tool" >/dev/null || { echo "Install $tool and put it on PATH before running the full suite." >&2; exit 1; }
done
python3 --version
hledger --version

stack test --interleaved-output
stack build hledger-flow shelltestrunner
case "$(uname -s)" in
    MINGW*|MSYS*) stack exec -- shelltest --timeout=120 --shell=sh --exclude=posix-preprocess.test test/shell test/windows ;;
    *) stack exec -- shelltest --timeout=120 test/shell ;;
esac
bash test/release/hackage.sh
bash test/release/snap.sh
stack install hledger-flow
