#!/usr/bin/env bash
# Release helper. See release-procedure.md for the full procedure.
#
# Usage: bin/release COMMAND [ARGS]
#
#   deps [RESOLVER]  Update stack.yaml (default: latest LTS) and cabal bounds, test, commit
#   precheck         Local checks; show '## Unreleased' next to the commits; list next versions
#   bump LEVEL|VER   LEVEL is major, minor or patch. Rename '## Unreleased', set version, commit
#   ci               Push master and wait for its CI run
#   changelog        Verify ChangeLog.md is up to date for the package.yaml version
#   check            All pre-tag checks (clean synced master, green CI, secrets, cabal, changelog)
#   tag              check, then create the signed tag locally
#   push-tag         PERMANENT: push the tag, verify binaries and prepare the Hackage candidate
#   verify           Verify the GitHub release has every expected asset
#   hackage          Upload a Hackage candidate
#   hackage-publish  PERMANENT: publish just the reviewed candidate (recovery)
#   publish          PERMANENT: publish on Hackage and GitHub, then update the Homebrew tap
#   notes [VERSION]  Print the GitHub release notes: .github/release-notice.md, then
#                    the ChangeLog.md section for VERSION
#
# Commands never prompt. Each one stops with an error naming the fix, and can be
# re-run once the fix is in. Only the PERMANENT commands can't be undone.

set -euo pipefail
cd "$(dirname "$0")/.."
export GIT_PAGER=cat  # git output is part of the report, never paged

REPO=apauley/hledger-flow
TAP=FernTrail/homebrew-tap
ASSETS="hledger-flow-linux-x64.tar.gz hledger-flow-linux-arm64.tar.gz hledger-flow-macos-x64.tar.gz hledger-flow-macos-arm64.tar.gz hledger-flow-windows-x64.zip"
CI_SECRETS="MACOS_CERTIFICATE_BASE64 MACOS_CERTIFICATE_PASSWORD APPLE_API_KEY_BASE64 APPLE_API_KEY_ID APPLE_API_ISSUER_ID"

die() { printf 'error: %b\n' "$*" >&2; exit 1; }
say() { printf '\n==> %s\n' "$*"; }
version() { awk '/^version:/ {print $2}' package.yaml; }
tag_exists() { git rev-parse -q --verify "refs/tags/$1" >/dev/null; }
remote_tag_exists() { git ls-remote --exit-code --tags origin "refs/tags/$1" >/dev/null; }
sdist_tarball() { echo "dist-newstyle/sdist/hledger-flow-$(version).tar.gz"; }
# hledger-flow.cabal is generated from package.yaml and committed with it. hpack
# refuses to overwrite one it thinks was edited (e.g. written by another hpack
# version), so always start fresh; git shows any real difference.
regen_cabal() { rm -f hledger-flow.cabal; stack build --only-configure; }
cabal_in_sync() {
  regen_cabal
  git diff --quiet -- hledger-flow.cabal \
    || die "hledger-flow.cabal does not match package.yaml: commit the regenerated file"
}

notes() {
  awk -v h="## ${1:-$(version)}" '$0 == h {f=1; next} /^## / {f=0} f' ChangeLog.md | sed '/./,$!d'
}

release_notes() {
  cat .github/release-notice.md
  echo
  notes "$@"
}

clean_master() {
  [ "$(git branch --show-current)" = master ] || die "not on master"
  [ -z "$(git status --porcelain)" ] || die "working tree not clean:\n$(git status --short)"
}

tap_access_ok() {
  command -v python3 >/dev/null || die "install Python 3 for the Homebrew tap update"
  [ "$(gh api "repos/$TAP" -q .permissions.push)" = true ] \
    || die "authenticate gh with write access to $TAP before publishing"
}

repo_settings_ok() {
  tap_access_ok
  local have n
  have=$({ gh secret list -R "$REPO"; gh variable list -R "$REPO"; } | cut -f1)
  for n in $CI_SECRETS; do grep -qx "$n" <<<"$have" || die "missing GitHub secret or variable $n"; done
  [ "$(gh api "repos/$REPO/immutable-releases" -q .enabled)" = true ] \
    || die "immutable releases are disabled: enable them in the repository's General settings"
}

# The CI path checks the secret name only. Cabal reads local credentials only
# when the maintainer explicitly chooses the fallback.
hackage_credentials_ok() {
  case ${HACKAGE_MODE:-ci} in
    ci)
      local secrets
      secrets=$(gh secret list -R "$REPO" --json name --jq '.[].name')
      grep -qx HACKAGE_TOKEN <<<"$secrets" || die "set the HACKAGE_TOKEN repository Actions secret to a Hackage API token, or use HACKAGE_MODE=local with configured Cabal credentials"
      ;;
    local)
      [ -n "${HACKAGE_TOKEN:-}" ] && return
      cabal user-config diff | awk '
        /^\+ token: [^[:space:]]/ { token=1 }
        /^\+ username: [^[:space:]]/ { user=1 }
        /^\+ (password|password-command): [^[:space:]]/ { password=1 }
        END { exit !(token || (user && password)) }
      ' || die "configure a token or username and password-command in your Cabal config for HACKAGE_MODE=local"
      ;;
    *) die "HACKAGE_MODE must be ci or local" ;;
  esac
}

# Every asset must carry a build provenance attestation from this repository's
# workflow, built from the release tag.
verify_provenance() (
  v=$(version)
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  gh release download "v$v" -R "$REPO" --dir "$dir"
  for a in $ASSETS; do
    gh attestation verify "$dir/$a" -R "$REPO" --deny-self-hosted-runners \
      --signer-workflow "$REPO/.github/workflows/build.yaml" --source-ref "refs/tags/v$v" >/dev/null \
      || die "$a has no valid build provenance for v$v"
  done
  say "All five binary archives have build provenance from refs/tags/v$v"
)

# PVP levels for A.B.C.D: major -> A.(B+1).0, minor -> A.B.(C+1), patch -> A.B.C.(D+1)
next_version() {
  awk -F. -v level="$1" '{
    if (level == "major") print $1 "." $2 + 1 ".0"
    else if (level == "minor") print $1 "." $2 "." $3 + 1
    else print $1 "." $2 "." $3 + 0 "." $4 + 1
  }' <<<"$(version)"
}

unreleased_ok() {
  [ "$(grep -m1 '^## ' ChangeLog.md)" = "## Unreleased" ] || die "ChangeLog.md must start with '## Unreleased'"
  notes Unreleased | grep -q '[^[:space:]]' || die "'## Unreleased' is empty: describe the changes first"
}

show_changes() { # PREV_TAG SECTION
  say "Commits since $1"
  git log --no-merges --format='  %h %s' "$1..HEAD"
  say "ChangeLog.md '## $2'"
  notes "$2"
}

run_for_commit() { # REPO WORKFLOW REF SHA
  local repo=$1 workflow=$2 ref=$3 sha=$4 id
  for _ in $(seq 30); do
    id=$(gh run list -R "$repo" --workflow "$workflow" --commit "$sha" --branch "$ref" \
           --json databaseId -q '.[0].databaseId')
    [ -n "$id" ] && break
    sleep 10
  done
  [ -n "$id" ] || die "no $workflow run in $repo for $ref at $sha; re-run this command to keep waiting"
  echo "$id"
}

# Notarization failures are only warnings: they don't block the release.
watch_run() { # REF SHA
  local id url failed
  id=$(run_for_commit "$REPO" build.yaml "$1" "$2")
  url=$(gh run view "$id" -R "$REPO" --json url -q .url)
  say "Waiting for $url"
  gh run watch "$id" -R "$REPO" --interval 30 >/dev/null 2>&1 || true
  [ "$(gh run view "$id" -R "$REPO" --json status -q .status)" = completed ] \
    || die "run $id has not finished; re-run this command to keep waiting"
  failed=$(gh run view "$id" -R "$REPO" --json jobs \
             -q '.jobs[] | select(.conclusion != "success" and .conclusion != "skipped") | .name')
  if [ -z "$failed" ]; then say "Run $id succeeded"; return; fi
  if grep -qv '^Notarize' <<<"$failed"; then
    die "run $id failed jobs:\n$failed\nInspect: gh run view $id -R $REPO --log-failed\nRetry transient failures: gh run rerun $id -R $REPO --failed, then re-run this command"
  fi
  echo "warning: notarization failed in run $id; see 'Recovery: notarization' in release-procedure.md" >&2
}

cmd_deps() {
  clean_master
  local resolver=${1:-$(curl -sfL https://www.stackage.org/download/snapshots.json | jq -r .lts)}
  say "Updating to $resolver"
  perl -pi -e "s/^resolver: .*/resolver: $resolver/" stack.yaml
  # Lower bound = snapshot version, upper bound = next PVP major (A.B -> A.(B+1)).
  # Only rewrites dependencies that already have '>= X && < Y' bounds.
  stack ls dependencies --depth 1 | while read -r pkg ver; do
    [ "$pkg" = base ] && continue
    upper=$(awk -F. '{print $1 "." $2 + 1}' <<<"$ver")
    perl -pi -e "s/^(\s*- \Q$pkg\E) >= \S+ && < \S+\$/\$1 >= $ver && < $upper/" package.yaml
  done
  regen_cabal
  bin/build-and-test
  cabal check
  if git diff --quiet -- stack.yaml stack.yaml.lock package.yaml hledger-flow.cabal; then
    say "Already on $resolver with current bounds"; return
  fi
  git diff -- stack.yaml package.yaml
  git commit -m "Update stackage to $resolver" -- stack.yaml stack.yaml.lock package.yaml hledger-flow.cabal
}

cmd_precheck() {
  local prev level
  clean_master
  repo_settings_ok
  hackage_credentials_ok
  cabal_in_sync
  cabal check
  unreleased_ok
  prev=$(git describe --tags --abbrev=0 --match 'v*' HEAD) || die "no previous release tag"
  show_changes "$prev" Unreleased
  say "Review before bumping"
  echo "  Compare the entries with the commits above using the writing guidelines at the top of ChangeLog.md."
  say "Next versions (choose with 'Choose the version number' in release-procedure.md)"
  for level in major minor patch; do
    printf '  bin/release bump %-5s  # %s\n' "$level" "$(next_version "$level")"
  done
}

cmd_bump() {
  local new=${1:?usage: bin/release bump major|minor|patch|VERSION} old
  case "$new" in major|minor|patch) new=$(next_version "$new") ;; esac
  old=$(version)
  clean_master
  [ "$new" != "$old" ] && [ "$(printf '%s\n%s\n' "$old" "$new" | sort -V | tail -1)" = "$new" ] \
    || die "$new is not greater than $old"
  tag_exists "v$new" && die "tag v$new already exists"
  unreleased_ok
  perl -pi -e "s/^version: .*/version: $new/" package.yaml
  perl -pi -e "s/^## Unreleased\$/## $new/" ChangeLog.md
  regen_cabal
  cmd_changelog
  git commit -m "Bump version to $new" -- package.yaml hledger-flow.cabal ChangeLog.md
}

cmd_ci() {
  clean_master
  git push origin master
  watch_run master "$(git rev-parse HEAD)"
}

cmd_changelog() {
  local v first prev
  v=$(version)
  first=$(grep -m1 '^## ' ChangeLog.md)
  [ "$first" = "## $v" ] || die "ChangeLog.md: first section is '$first', expected '## $v' (run: bin/release bump $v)"
  notes "$v" | grep -q '[^[:space:]]' || die "ChangeLog.md: section '## $v' is empty"
  prev=$(git describe --tags --abbrev=0 --match 'v*' --exclude "v$v" HEAD) || die "no previous release tag"
  [ -n "$(git diff --name-only "$prev" HEAD -- ChangeLog.md)" ] || die "ChangeLog.md unchanged since $prev"
  show_changes "$prev" "$v"
}

cmd_check() {
  local v ci late
  v=$(version)
  clean_master
  git fetch -q origin master
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/master)" ] || die "HEAD is not origin/master (run: bin/release ci)"
  remote_tag_exists "v$v" && die "v$v is already released: its tag is on origin"
  tag_exists "v$v" && die "tag v$v exists locally but was not pushed: delete it with 'git tag -d v$v' and re-run"
  ci=$(gh run list -R "$REPO" --workflow build.yaml --commit "$(git rev-parse HEAD)" --branch master \
         --json conclusion -q '.[0].conclusion')
  [ "$ci" = success ] || die "CI for HEAD is '${ci:-missing}' (run: bin/release ci)"
  repo_settings_ok
  hackage_credentials_ok
  cabal_in_sync
  cabal check
  cabal sdist
  cmd_changelog
  # precheck reviewed everything up to the bump; flag commits made since.
  late=$(git log --no-merges --format='  %h %s' "$(git log -1 --format=%H -- ChangeLog.md)..HEAD")
  if [ -n "$late" ]; then
    say "Review: commits after the last ChangeLog.md change"
    echo "$late"
  fi
}

cmd_tag() {
  local v
  v=$(version)
  cmd_check
  bin/tag-release
  say "Created local tag v$v at $(git rev-parse --short "v$v^{commit}"). Release notes:"
  release_notes "$v"
  say "Next: bin/release push-tag (permanent: starts the release build)"
  echo "  To change anything first: git tag -d v$v, commit the fix, then bin/release ci and tag again."
}

cmd_push_tag() {
  local v sha
  v=$(version)
  tag_exists "v$v" || die "no local tag v$v (run: bin/release tag)"
  sha=$(git rev-parse "v$v^{commit}")
  git fetch -q origin master
  [ "$sha" = "$(git rev-parse origin/master)" ] || die "tag v$v is not at origin/master"
  git push origin "v$v"
  watch_run "v$v" "$sha"
  cmd_verify
  verify_provenance
  cmd_hackage
  gh release view "v$v" -R "$REPO" --json url -q .url
  say "Review the GitHub draft and $(candidate_url) before running bin/release publish"
}

cmd_verify() {
  local v have a
  v=$(version)
  have=$(gh release view "v$v" -R "$REPO" --json assets -q '.assets[].name')
  for a in $ASSETS; do grep -qx "$a" <<<"$have" || die "release v$v is missing $a"; done
  say "Release v$v has all five binary archives"
}

dispatch_hackage() {
  local stage=$1 run_id
  run_id=$(gh api -X POST "repos/$REPO/actions/workflows/hackage.yaml/dispatches" \
    -H 'X-GitHub-Api-Version: 2026-03-10' -f ref="v$(version)" \
    -f "inputs[stage]=$stage" --jq '.workflow_run_id')
  say "Waiting for https://github.com/$REPO/actions/runs/$run_id"
  gh run watch "$run_id" -R "$REPO" --exit-status
}

hackage_upload() {
  if [ -n "${HACKAGE_TOKEN:-}" ]; then set -- --token="$HACKAGE_TOKEN" "$@"; fi
  cabal upload "$@" </dev/null
}

candidate_url() { echo "https://hackage.haskell.org/package/hledger-flow-$(version)/candidate"; }
package_url() { echo "https://hackage.haskell.org/package/hledger-flow-$(version)"; }

# GitHub records the digest of the source archive attached to this release.
source_digest() {
  local name
  name=$(basename "$(sdist_tarball)")
  gh release view "v$(version)" -R "$REPO" --json assets |
    jq -r --arg name "$name" '.assets[] | select(.name == $name) | .digest'
}

# Only 404 means the package is absent. Fail closed on network or server errors.
fetch_archive() {
  local status
  status=$(curl -sSL -w '%{http_code}' -o "$2" "$1") || die "could not download $1"
  case "$status" in
    200) echo present ;;
    404) echo absent ;;
    *) die "downloading $1 returned HTTP $status" ;;
  esac
}

check_digest() {
  local actual
  actual=$(shasum -a 256 "$1" | cut -d' ' -f1)
  [ "sha256:$actual" = "$2" ] || die "$1 differs from the source archive recorded on the GitHub release"
}

check_hackage_tag() {
  local tag
  tag="v$(version)"
  [ "$(git rev-parse HEAD)" = "$(git rev-parse "$tag^{commit}")" ] && [ -z "$(git status --porcelain)" ] \
    || die "start from a clean checkout of $tag"
  cmd_verify
}

cmd_hackage() (
  hackage_credentials_ok
  if [ "${HACKAGE_MODE:-ci}" = ci ]; then
    dispatch_hackage candidate
    say "Review $(candidate_url)"
    return
  fi
  check_hackage_tag
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  tarball=$(sdist_tarball)
  name=$(basename "$tarball")
  digest=$(source_digest)
  if [ -z "$digest" ]; then
    cabal check
    cabal sdist
    # Never overwrite the release's source archive, including on a retry.
    gh release upload "v$(version)" "$tarball" -R "$REPO"
    digest=$(source_digest)
    check_digest "$tarball" "$digest"
  fi
  [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "missing SHA-256 for $name on the GitHub draft"
  url="$(candidate_url)/$name"
  state=$(fetch_archive "$url" "$dir/candidate")
  if [ "$state" = absent ]; then
    gh release download "v$(version)" -R "$REPO" --pattern "$name" --dir "$dir"
    check_digest "$dir/$name" "$digest"
    hackage_upload "$dir/$name"
    curl -fsSL "$url" -o "$dir/candidate"
  fi
  check_digest "$dir/candidate" "$digest"
  say "Review the candidate: $(candidate_url)"
)

cmd_hackage_publish() (
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  name=$(basename "$(sdist_tarball)")
  digest=$(source_digest)
  [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "missing source archive for v$(version) (run: bin/release hackage and review the candidate)"
  public_url="$(package_url)/$name"
  state=$(fetch_archive "$public_url" "$dir/$name")
  if [ "$state" = absent ]; then
    hackage_credentials_ok
    if [ "${HACKAGE_MODE:-ci}" = ci ]; then
      dispatch_hackage publish
    else
      check_hackage_tag
      curl -fsSL "$(candidate_url)/$name" -o "$dir/$name"
      check_digest "$dir/$name" "$digest"
      hackage_upload --publish "$dir/$name"
    fi
    curl -fsSL "$public_url" -o "$dir/$name"
  fi
  check_digest "$dir/$name" "$digest"
  say "Verified published package: $(package_url)"
)

update_homebrew_tap() (
  tag="v$(version)"
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  export GIT_TERMINAL_PROMPT=0 GH_PROMPT_DISABLED=1
  gh release view "$tag" -R "$REPO" --json assets > "$dir/assets.json"
  curl -fsSL "https://raw.githubusercontent.com/$REPO/$tag/LICENSE" -o "$dir/LICENSE"
  gh repo clone "$TAP" "$dir/tap" -- --branch main --single-branch
  python3 bin/update-homebrew-formula.py "$tag" "$dir/assets.json" "$dir/LICENSE" "$dir/tap"

  cd "$dir/tap"
  if ! git diff --quiet -- Formula/hledger-flow.rb README.md; then
    git diff --check
    git commit -m "Update hledger-flow to $tag" -- Formula/hledger-flow.rb README.md
    git push origin HEAD:main || die "tap push failed; check access to $TAP/main and re-run bin/release publish"
  fi

  # On a retry, CI for the current tap revision tests the already-published formula.
  sha=$(git rev-parse HEAD)
  id=$(run_for_commit "$TAP" test.yml main "$sha")
  say "Checking $TAP at $sha: https://github.com/$TAP/actions/runs/$id"
  gh run watch "$id" -R "$TAP" --exit-status || die "inspect tap CI with gh run view $id -R $TAP --log-failed; fix the tap or rerun failed jobs, then re-run bin/release publish"
  say "Published $tag to $TAP"
)

cmd_publish() {
  local v draft
  v=$(version)
  tap_access_ok
  cmd_verify
  draft=$(gh release view "v$v" -R "$REPO" --json isDraft -q .isDraft)
  cmd_hackage_publish
  if [ "$draft" = true ]; then
    gh release edit "v$v" -R "$REPO" --draft=false --latest
  fi
  # GitHub attests an immutable release when it is published.
  for _ in $(seq 12); do
    gh release verify "v$v" -R "$REPO" >/dev/null 2>&1 && break
    sleep 5
  done
  gh release verify "v$v" -R "$REPO" || die "v$v is published but has no release attestation"
  gh release view "v$v" -R "$REPO" --json url -q .url
  update_homebrew_tap
}

case "${1:-}" in
  deps|precheck|bump|ci|changelog|check|tag|push-tag|verify|hackage|hackage-publish|publish)
    c=${1//-/_}; shift; "cmd_$c" "$@" ;;
  notes) shift; release_notes "$@" ;;
  *) sed -n '4,22s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
