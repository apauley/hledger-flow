#!/usr/bin/env python3
"""Report GitHub release download counts for hledger-flow.

Usage: bin/show-release-downloads [owner/repo] [--self-test]
Set GITHUB_TOKEN to avoid the unauthenticated API rate limit. NO_COLOR is honoured.
"""
import json
import os
import re
import shutil
import sys
import urllib.request
from datetime import datetime, timezone

REPO = "apauley/hledger-flow"
PLATFORMS = ["linux-x64", "linux-arm64", "macos-x64", "macos-arm64", "windows-x64"]
USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if USE_COLOR else str(s)


bold, dim, cyan, green, yellow, magenta = (lambda s, k=k: c(k, s) for k in ("1", "2", "36", "32", "33", "35"))
ANSI = re.compile(r"\033\[[0-9;]*m")


def platform(asset_name):
    n = asset_name.lower()
    # "windows", not "win": "darwin" contains "win".
    found = [os_ for os_, keys in (("linux", ("linux",)), ("macos", ("darwin", "macos", "osx")), ("windows", ("windows",)))
             if any(k in n for k in keys)]
    if len(found) > 1:
        return "+".join(found)  # a bundle with binaries for several OSes
    if not found:
        return "other"
    arch = "arm64" if ("arm64" in n or "aarch64" in n) else "x64"
    return f"{found[0]}-{arch}"


def bar(value, maximum, width):
    if maximum <= 0 or width <= 0:
        return ""
    eighths = max(round(value / maximum * width * 8), 1 if value > 0 else 0)
    full, part = divmod(eighths, 8)
    return "█" * full + ("", "▏", "▎", "▍", "▌", "▋", "▊", "▉")[part]


def fetch(repo):
    headers = {"Accept": "application/vnd.github+json", "User-Agent": "hledger-flow-release-report"}
    if token := os.environ.get("GITHUB_TOKEN"):
        headers["Authorization"] = f"Bearer {token}"
    releases, page = [], 1
    while True:
        url = f"https://api.github.com/repos/{repo}/releases?per_page=100&page={page}"
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers)) as r:
            batch = json.load(r)
        if not batch:
            return releases
        releases += batch
        page += 1


def parse_time(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def table(rows, aligns, bars=None, term_w=80):
    """Print aligned rows; if bars is a list of callables (width -> str), they fill the remaining terminal width."""
    widths = [max(len(ANSI.sub("", str(r[i]))) for r in rows) for i in range(len(aligns))]
    if bars:
        bar_w = max(10, min(50, term_w - sum(widths) - 2 * len(widths) - 3))
        rows = [r + [b(bar_w) if b else ""] for r, b in zip(rows, bars)]
        widths, aligns = widths + [0], aligns + ["<"]
    for r in rows:
        cells = []
        for cell, w, a in zip(r, widths, aligns):
            pad = " " * (w - len(ANSI.sub("", str(cell))))
            cells.append(f"{cell}{pad}" if a == "<" else f"{pad}{cell}")
        print("  " + "  ".join(cells).rstrip())


def report(repo):
    now = datetime.now(timezone.utc)
    releases = []
    for r in fetch(repo):
        if r["draft"] or not r.get("published_at"):
            continue
        # Skip pre-rename hledger-makeitso builds, and the releases that only had those.
        kept = [a for a in r["assets"] if not a["name"].startswith("hledger-makeitso")]
        if r["assets"] and not kept:
            continue
        releases.append({**r, "assets": kept})
    releases.sort(key=lambda r: r["published_at"])
    if not releases:
        print(f"No published releases for {repo}.")
        return

    # Each release is "current" from its publish date until the next one is published.
    stats = []
    for i, r in enumerate(releases):
        start = parse_time(r["published_at"])
        end = parse_time(releases[i + 1]["published_at"]) if i + 1 < len(releases) else now
        by_platform = {}
        for a in r["assets"]:
            p = platform(a["name"])
            by_platform[p] = by_platform.get(p, 0) + a["download_count"]
        total = sum(by_platform.values())
        current_days = max((end - start).total_seconds() / 86400, 1)
        stats.append(dict(r=r, start=start, total=total, by=by_platform, per_day=total / current_days))

    grand = sum(s["total"] for s in stats)
    plat_totals = {}
    for s in stats:
        for p, n in s["by"].items():
            plat_totals[p] = plat_totals.get(p, 0) + n
    plat_totals = {p: n for p, n in plat_totals.items() if n}
    shown_platforms = [p for p in PLATFORMS if p in plat_totals] + sorted(set(plat_totals) - set(PLATFORMS))
    top = max(stats, key=lambda s: s["total"])
    latest = stats[-1]
    term_w = shutil.get_terminal_size((120, 24)).columns

    print()
    print(bold(f"  {repo}") + dim("  ·  GitHub release downloads  ·  ") + dim(now.strftime("%Y-%m-%d %H:%M UTC")))
    print()
    summary = [
        ("Total downloads", bold(green(f"{grand:,}"))),
        ("Releases", f"{len(stats)}  " + dim(f"({stats[0]['r']['tag_name']} → {latest['r']['tag_name']})")),
        ("Latest release", f"{cyan(latest['r']['tag_name'])}  {latest['start']:%Y-%m-%d}  "
                           + dim(f"{(now - latest['start']).days} days ago, {latest['total']:,} downloads")),
        ("Most downloaded", f"{cyan(top['r']['tag_name'])}  {top['total']:,} "
                            + dim(f"({top['total'] / grand:.0%} of all)" if grand else "")),
        ("Average / release", f"{grand / len(stats):,.0f}"),
        ("Release cadence", f"{(now - stats[0]['start']).days / len(stats):,.0f} days between releases on average"),
    ]
    for label, value in summary:
        print(f"  {dim(label.ljust(18))} {value}")

    # Per-release table, newest first.
    print()
    print(bold("  Downloads per release"))
    print()
    header = ["Release", "Published", "Total", "/day*"] + shown_platforms
    max_total = max(s["total"] for s in stats)
    rows, bars = [[dim(h) for h in header]], [None]
    for s in reversed(stats):
        tag = s["r"]["tag_name"] + (" (pre)" if s["r"]["prerelease"] else "")
        colour = yellow if s is top else green
        rows.append(
            [cyan(tag) if s is latest else tag, s["start"].strftime("%Y-%m-%d"),
             bold(f"{s['total']:,}") if s is top else f"{s['total']:,}", f"{s['per_day']:.1f}"]
            + [f"{s['by'][p]:,}" if s["by"].get(p) else dim("·") for p in shown_platforms]
        )
        bars.append(lambda w, t=s["total"], col=colour: col(bar(t, max_total, w)))
    rows.append([""] * len(header))
    rows.append([bold("All"), "", bold(f"{grand:,}"), ""] + [bold(f"{plat_totals[p]:,}") for p in shown_platforms])
    bars += [None, None]
    table(rows, ["<", "<", ">", ">"] + [">"] * len(shown_platforms), bars, term_w)
    print(dim("  * downloads per day while it was the newest release (all downloads attributed to that window)"))

    # Platform breakdown.
    print()
    print(bold("  Downloads by platform"))
    print()
    max_p = max(plat_totals.values())
    ranked = sorted(plat_totals.items(), key=lambda kv: -kv[1])
    rows = [[p, f"{n:,}", dim(f"{n / grand:5.1%}")] for p, n in ranked]
    bars = [lambda w, n=n: magenta(bar(n, max_p, w)) for _, n in ranked]
    table(rows, ["<", ">", ">"], bars, term_w)

    # Downloads by year of release.
    print()
    print(bold("  Downloads by release year"))
    print()
    years = {}
    for s in stats:
        y = years.setdefault(s["start"].year, [0, 0])
        y[0] += s["total"]
        y[1] += 1
    max_y = max(t for t, _ in years.values())
    ordered = sorted(years.items())
    rows = [[str(y), f"{t:,}", dim(f"{n} release{'s' * (n != 1)}")] for y, (t, n) in ordered]
    bars = [lambda w, t=t: green(bar(t, max_y, w)) for _, (t, _n) in ordered]
    table(rows, ["<", ">", "<"], bars, term_w)
    print()


def self_test():
    assert platform("hledger-flow-linux-x64.tar.gz") == "linux-x64"
    assert platform("hledger-flow-macos-arm64.tar.gz") == "macos-arm64"
    assert platform("hledger-flow_Linux_x86_64_v0.12.0_lts-13.16_bee8986.tar.gz") == "linux-x64"
    assert platform("hledger-flow_MacOSX_Darwin_arm64_v0.14.0_5901ca5.tar.gz") == "macos-arm64"
    assert platform("hledger-flow-Darwin-x86_64-v0.15.0-9cd1222.tar.gz") == "macos-x64"
    assert platform("hledger-makeitso-v0.10-linux-osx.tar.gz") == "linux+macos"
    assert platform("hledger-flow-windows-x64.zip") == "windows-x64"
    assert platform("hledger-flow-source.tar.gz") == "other"
    assert bar(0, 10, 10) == "" and bar(10, 10, 10) == "█" * 10 and bar(5, 10, 3) == "█▌"
    print("ok")


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--self-test" in args:
        self_test()
    else:
        report(args[0] if args else REPO)
