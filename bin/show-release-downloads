#!/usr/bin/env python3
"""Report lifetime asset downloads for published GitHub releases."""
import argparse
import calendar
import re
import shutil
from datetime import date, datetime, timezone

from github_releases import (DEFAULT_REPO, bar, bold, cyan, dim, github_get, green, magenta, platform, repository,
                             table, yellow)

PLATFORMS = ["linux-x64", "linux-arm64", "linux-arm32", "macos-x64", "macos-arm64", "windows-x64"]
MIN_RATE_DAYS = 7


def fetch(repo):
    page = 1
    while True:
        batch = github_get(repo, f"?per_page=100&page={page}")
        yield from batch
        if len(batch) < 100:
            return
        page += 1


def since_date(value):
    try:
        if re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value):
            return date.fromisoformat(value)
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("expected a valid date in YYYY-MM-DD form")


def parse_time(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def report(repo, since=None):
    now = datetime.now(timezone.utc)
    releases = []
    for r in fetch(repo):
        if r["draft"] or not r.get("published_at"):
            continue
        if since and parse_time(r["published_at"]).date() < since:
            continue
        # Skip pre-rename hledger-makeitso builds, and the releases that only had those.
        if repo.lower() == DEFAULT_REPO:
            kept = [a for a in r["assets"] if not a["name"].startswith("hledger-makeitso")]
            if r["assets"] and not kept:
                continue
            r = {**r, "assets": kept}
        releases.append(r)
    releases.sort(key=lambda r: r["published_at"])
    if not releases:
        period = f" on or after {since}" if since else ""
        print(f"No published releases for {repo}{period}.")
        return

    # Each release is "current" from its publish date until a later release replaces it:
    # any later release replaces a prerelease, but only a later full release replaces a full release.
    stats = []
    for i, r in enumerate(releases):
        start = parse_time(r["published_at"])
        later = [n for n in releases[i + 1:] if r["prerelease"] or not n["prerelease"]]
        end = parse_time(later[0]["published_at"]) if later else now
        by_platform = {}
        for a in r["assets"]:
            p = platform(a["name"])
            by_platform[p] = by_platform.get(p, 0) + a["download_count"]
        total = sum(by_platform.values())
        current_days = (end - start).total_seconds() / 86400
        # Lifetime downloads over a window of a few days (e.g. a same-week backport) give a meaningless rate.
        per_day = total / current_days if current_days >= MIN_RATE_DAYS else None
        stats.append(dict(r=r, start=start, total=total, by=by_platform, per_day=per_day))

    grand = sum(s["total"] for s in stats)
    plat_totals = {}
    for s in stats:
        for p, n in s["by"].items():
            plat_totals[p] = plat_totals.get(p, 0) + n
    plat_totals = {p: n for p, n in plat_totals.items() if n}
    shown_platforms = [p for p in PLATFORMS if p in plat_totals] + sorted(set(plat_totals) - set(PLATFORMS))
    top = max(stats, key=lambda s: s["total"])
    latest = next((s for s in reversed(stats) if not s["r"]["prerelease"]), stats[-1])
    prereleases = sum(s["r"]["prerelease"] for s in stats)
    term_w = shutil.get_terminal_size((120, 24)).columns

    print()
    print(bold(f"  {repo}") + dim("  ·  GitHub release downloads  ·  ") + dim(now.strftime("%Y-%m-%d %H:%M UTC")))
    if since:
        print(f"  Releases published on or after {since} (UTC)")
    print()
    summary = [
        ("Total downloads", bold(green(f"{grand:,}"))),
        ("Releases", f"{len(stats)}  " + dim(f"({stats[0]['r']['tag_name']} → {stats[-1]['r']['tag_name']}"
                                             + (f", {prereleases} prereleases" if prereleases else "") + ")")),
        ("Latest release", f"{cyan(latest['r']['tag_name'])}  {latest['start']:%Y-%m-%d}  "
                           + dim(f"{(now - latest['start']).days} days ago, {latest['total']:,} downloads")),
        ("Most downloaded", f"{cyan(top['r']['tag_name'])}  {top['total']:,} "
                            + dim(f"({top['total'] / grand:.0%} of all)" if grand else "")),
        ("Average / release", f"{grand / len(stats):,.0f}"),
    ]
    if len(stats) > 1:
        average_gap = (stats[-1]["start"] - stats[0]["start"]).total_seconds() / 86400 / (len(stats) - 1)
        summary.append(("Release cadence", f"{average_gap:,.0f} days between releases on average"))
    for label, value in summary:
        print(f"  {dim(label.ljust(18))} {value}")

    # Per-release table, newest first.
    print()
    print(bold("  Downloads per release"))
    print()
    header = ["Release", "Published", "Total", "/day*"] + shown_platforms
    max_total = max(s["total"] for s in stats)
    rows, bars = [[dim(h) for h in header]], [None]
    for s in reversed(stats):
        tag = s["r"]["tag_name"] + (" (pre)" if s["r"]["prerelease"] else "")
        colour = yellow if s is top else green
        rows.append(
            [cyan(tag) if s is latest else tag, s["start"].strftime("%Y-%m-%d"),
             bold(f"{s['total']:,}") if s is top else f"{s['total']:,}", f"{s['per_day']:.1f}" if s["per_day"] is not None else dim("–")]
            + [f"{s['by'][p]:,}" if s["by"].get(p) else dim("·") for p in shown_platforms]
        )
        bars.append(lambda w, t=s["total"], col=colour: col(bar(t, max_total, w)))
    rows.append([""] * len(header))
    rows.append([bold("All"), "", bold(f"{grand:,}"), ""] + [bold(f"{plat_totals[p]:,}") for p in shown_platforms])
    bars += [None, None]
    table(rows, ["<", "<", ">", ">"] + [">"] * len(shown_platforms), bars, term_w)
    print(dim("  * downloads per day while it was the newest release (all downloads attributed to that window;"))
    print(dim(f"    a prerelease does not replace a full release; – means a window under {MIN_RATE_DAYS} days)"))

    # Platform breakdown.
    print()
    print(bold("  Downloads by platform"))
    print()
    if plat_totals:
        max_p = max(plat_totals.values())
        ranked = sorted(plat_totals.items(), key=lambda kv: -kv[1])
        rows = [[p, f"{n:,}", dim(f"{n / grand:5.1%}")] for p, n in ranked]
        bars = [lambda w, n=n: magenta(bar(n, max_p, w)) for _, n in ranked]
        table(rows, ["<", ">", ">"], bars, term_w)
    else:
        print("  No asset downloads.")

    # Downloads by year of release.
    print()
    print(bold("  Downloads by release year"))
    print()
    years = {}
    for s in stats:
        y = years.setdefault(s["start"].year, [0, 0])
        y[0] += s["total"]
        y[1] += 1
    max_y = max(t for t, _ in years.values())
    ordered = sorted(years.items())
    rows = [[str(y), f"{t:,}", dim(f"{n} release{'s' * (n != 1)}")] for y, (t, n) in ordered]
    bars = [lambda w, t=t: green(bar(t, max_y, w)) for _, (t, _n) in ordered]
    table(rows, ["<", ">", "<"], bars, term_w)

    print()
    print(bold("  Downloads by release publication month"))
    print(dim("  Lifetime asset downloads grouped by the month each release was published, across years."))
    print()
    months = [0] * 12
    for s in stats:
        months[s["start"].month - 1] += s["total"]
    max_month = max(months)
    rows = [[calendar.month_abbr[i], f"{n:,}"] for i, n in enumerate(months, 1)]
    bars = [lambda w, n=n: green(bar(n, max_month, w)) for n in months]
    table(rows, ["<", ">"], bars, term_w)
    print()


def self_test():
    assert platform("hledger-flow-linux-x64.tar.gz") == "linux-x64"
    assert platform("hledger-flow-macos-arm64.tar.gz") == "macos-arm64"
    assert platform("hledger-flow_Linux_x86_64_v0.12.0_lts-13.16_bee8986.tar.gz") == "linux-x64"
    assert platform("hledger-flow_MacOSX_Darwin_arm64_v0.14.0_5901ca5.tar.gz") == "macos-arm64"
    assert platform("hledger-flow-Darwin-x86_64-v0.15.0-9cd1222.tar.gz") == "macos-x64"
    assert platform("hledger-makeitso-v0.10-linux-osx.tar.gz") == "linux+macos"
    assert platform("hledger-flow-windows-x64.zip") == "windows-x64"
    assert platform("hledger-flow-source.tar.gz") == "other"
    assert platform("hledger-mac-arm64.tar.gz") == "macos-arm64" and platform("hledger-mac-x64.zip") == "macos-x64"
    assert platform("hledger-ubuntu.zip") == "linux-x64" and platform("hledger-aarch64-manjaro.gz") == "linux-arm64"
    assert platform("hledger-linux-static-arm32v7.zip") == "linux-arm32" and platform("hledger-armhf32-debian.gz") == "linux-arm32"
    assert bar(0, 10, 10) == "" and bar(10, 10, 10) == "█" * 10 and bar(5, 10, 3) == "█▌"
    print("ok")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__, epilog="Set GITHUB_TOKEN for a higher GitHub API rate limit.")
    repos = parser.add_mutually_exclusive_group()
    repos.add_argument("repository", nargs="?", type=repository, metavar="OWNER/REPO", help="repository to report on")
    repos.add_argument("--repo", type=repository, metavar="OWNER/REPO", help=f"repository (default: {DEFAULT_REPO})")
    parser.add_argument("--since", type=since_date, metavar="YYYY-MM-DD",
                        help="include releases published on or after this UTC date")
    parser.add_argument("--self-test", action="store_true", help="run offline checks")
    args = parser.parse_args()
    if args.self_test:
        self_test()
    else:
        report(args.repo or args.repository or DEFAULT_REPO, args.since)
