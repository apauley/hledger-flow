# An interrupted hledger version probe cancels status; an ordinary failure means unavailable.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
printf '%s\n' '#!/bin/sh' 'touch probe-started' 'exec sleep 30' > probe
chmod +x probe
python3 - <<'PY'
import os, signal, subprocess, time
from pathlib import Path
cmd = ["hledger-flow", "--hledger-path", os.path.abspath("probe"), "status", "--json"]
with subprocess.Popen(cmd, stdout=subprocess.PIPE) as process:
    for _ in range(500):
        if Path("probe-started").exists():
            break
        time.sleep(0.01)
    else:
        process.kill()
        raise AssertionError("version probe did not start")
    process.send_signal(signal.SIGINT)
    output, _ = process.communicate(timeout=10)
    assert process.returncode != 0 and not output, "interrupted status produced a result"
PY
printf '%s\n' '#!/bin/sh' 'exit 17' > probe
hledger-flow --hledger-path "$PWD/probe" status --json | jq -e 'has("hledger") and .hledger == null' > /dev/null
if hledger-flow --show-options --hledger-path "$PWD/probe" import 2> err; then exit 1; else test "$?" -eq 17; fi
$ sh -eu

# Ordinary and skipped imports need no version lookup. Parallel glob paths share one.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
cat > probe <<'SH'
#!/bin/sh
if test "$1" = --version; then echo probe >> versions; fi
exec hledger "$@"
SH
if hledger-flow -H "$PWD/probe" import --start-year 2099 > /dev/null 2>&1; then exit 1; fi
chmod +x probe
flow -H "$PWD/probe" import
flow -H "$PWD/probe" import --new-files-only
flow -H "$PWD/probe" import --start-year 2099
test ! -f versions
cp "$inbox/march.csv" "$inbox/march[1].csv"
cp "$inbox/march.csv" "$inbox/march[2].csv"
flow -H "$PWD/probe" import
test "$(wc -l < versions)" -eq 1
flow --show-options -H "$PWD/probe" import --new-files-only
test "$(wc -l < versions)" -eq 2
$ sh -eu

# An explicit hledger path works without PATH and distinguishes a non-executable file.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
flow_exe=$(command -v hledger-flow)
hl_exe=$(command -v hledger)
# Use a cached journal so hledger's own PATH requirements are independent of this lookup.
flow import
env -u PATH "$flow_exe" -H "$hl_exe" import --new-files-only > out
grep -q '1 already up to date' out
touch probe
if "$flow_exe" -H "$PWD/probe" import > out 2> err; then exit 1; fi
grep -Fi 'not executable' err | grep -Fq "$PWD/probe"
$ sh -eu

# A required probe must succeed before an earlier ordinary statement can publish output.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
cp "$inbox/march.csv" "$inbox/z[1].csv"
printf '%s\n' '#!/bin/sh' 'if test "$1" = --version; then exit 17; fi' 'exec hledger "$@"' > probe
chmod +x probe
if hledger-flow -H "$PWD/probe" --batch-size 1 import > out 2> err; then exit 1; else test "$?" -eq 17; fi
test ! -e "$journal"
test ! -e "$account/3-journal/2016/z[1].journal"
grep -F -- '--version' err | grep -F "$PWD/probe" | grep -q '17'
$ sh -eu

# A construct hook reads a bracketed filename itself and passes stdin to hledger.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
mv "$inbox/march.csv" "$inbox/march[1].csv"
printf '%s\n' '#!/bin/sh' 'echo "2016-03-01 Fee"' 'echo "    expenses:fees  5"' 'echo "    assets:bank"' > "$account/construct"
chmod +x "$account/construct"
flow import
test -s "$account/3-journal/2016/march[1].journal"
$ sh -eu
