# Bare invocation in an empty folder suggests init.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
hledger-flow
$ sh -eu
This folder is empty.
Next: Preview the starter files
      hledger-flow init --dry-run
Then run `hledger-flow init` to create them.

# Bare invocation in an unrelated folder shows commands and writes nothing.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
touch notes.txt
hledger-flow > ../out.$$
grep -q '^Commands:' ../out.$$
grep -q '^      hledger-flow init --dry-run' ../out.$$
if grep -q "$(printf '\033')" ../out.$$; then exit 1; fi
grep -q 'No hledger-flow ledger here or in any parent folder' ../out.$$
rm ../out.$$
test "$(ls)" = notes.txt
$ sh -eu

# First-time path: misplaced CSV, missing rules, import, LEDGER_FILE, report; never coloured when piped.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
mkdir -p import/me/mybank
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > import/me/mybank/jan.csv
hledger-flow status | grep -q 'Next: Move 1 file to where hledger-flow looks'
hledger-flow status --json | jq -e '.misplaced[0].suggestion | split("\\") | join("/") == "import/me/mybank/<account>/1-in/2026/jan.csv"' > /dev/null
mkdir -p import/me/mybank/checking/1-in/2026 && mv import/me/mybank/jan.csv import/me/mybank/checking/1-in/2026/
hledger-flow status --json | jq -e '.next.command == "hledger-flow rules me/mybank/checking"' > /dev/null
printf 'skip 1\nfields date, description, amount\naccount1 assets:checking\n' > import/me/mybank/checking/mybank-checking.rules
hledger-flow status --json | jq -e '.next.command == "hledger-flow import"' > /dev/null
hledger-flow import > /dev/null
case "$(uname -s)" in
    MINGW*|MSYS*) prefix='$env:LEDGER_FILE = ' ;;
    *) prefix='export LEDGER_FILE=' ;;
esac
hledger-flow status --json | jq -e --arg prefix "$prefix" '(.next.command == "hledger-flow report") and (.ledgerFileNote | contains($prefix))' > /dev/null
export LEDGER_FILE="$(native_pwd)/all-years.journal"
hledger-flow status > ../out.$$
grep -q 'Run: hledger-flow report' ../out.$$
if grep -q "$(printf '\033')" ../out.$$; then exit 1; fi
rm ../out.$$
$ sh -eu

# Suggest prices for a multi-commodity ledger until it has a market price.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
mkdir -p import/me/_manual_/2026 prices/2026
journal=import/me/_manual_/2026/pre-import.journal
prices=prices/2026/prices.journal
printf '2026-01-01 Opening\n    assets:checking  10 EUR\n    equity:opening balances\n' > "$journal"
printf '; Prices go here\n' > "$prices"
export LEDGER_FILE="$(native_pwd)/all-years.journal"
hledger-flow import > /dev/null
hledger-flow status | grep -q '^Next: Generate reports'
printf '\n2026-01-02 Opening\n    assets:savings  10 USD\n    equity:opening balances\n' >> "$journal"
unset LEDGER_FILE
hledger-flow status --json | jq -e '.next.docs == "https://hledger-flow.github.io/go/price-files/"' > /dev/null
hledger-flow status | grep -q '^Next: Add market prices'
hledger-flow status | grep -q 'prices/<year>/<commodity>-<quote>.prices'
printf 'P 2026-01-01 USD 0.90 EUR\n' >> "$prices"
export LEDGER_FILE="$(native_pwd)/all-years.journal"
hledger-flow status | grep -q '^Next: Generate reports'
$ sh -eu

# Status works from deep inside an account and in a folder with spaces.
<
. ./test/shell/status-commands.sh
dir="$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")/my finances"
mkdir -p "$dir/import/me/mybank/checking/1-in/2026" && cd "$dir"
printf 'Date,Desc,Amount\n' > import/me/mybank/checking/1-in/2026/jan.csv
hledger-flow status > ../top
(cd import/me/mybank/checking/1-in/2026 && hledger-flow status) > ../deep
sed '/^Next:/,$d' ../top > ../top-status
sed '/^Next:/,$d' ../deep > ../deep-status
cmp ../top-status ../deep-status
if grep -q 'Changing runDir' ../deep; then exit 1; fi
test "$(hledger-flow status --json | jq -r .baseDir | tr -d '\r')" = "$(native_pwd)"
$ sh -eu

# init --dry-run lists exactly the files a real init creates, including in a missing directory.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
hledger-flow init --dry-run nested/ledger > preview
test ! -e nested
mkdir blocked
touch blocked/prices
if hledger-flow init blocked --dry-run 2> error; then exit 1; fi
test "$(find blocked -mindepth 1)" = blocked/prices
mkdir -p nested/ledger
cd nested/ledger
printf '; keep this file\n' > directives.journal
hledger-flow init --dry-run > ../../existing
tr -d '\r' < ../../existing | grep -Fxq 'Would keep existing directives.journal'
test "$(find . -mindepth 1)" = ./directives.journal
grep -Fxq '; keep this file' directives.journal
printf '; A separate ledger\n' > ../../other.journal
LEDGER_FILE=../../other.journal hledger-flow init > ../../created
sed -n -e 's/^Would create /Created /p' -e 's/^Would keep existing /Kept existing /p' ../../existing > ../../expected
grep -E '^(Created |Kept existing )' ../../created > ../../reported
cmp ../../expected ../../reported
find . -type f | sed 's|^\./||' | sort > ../../actual
sed -n 's/^Would create //p' ../../preview | tr -d '\r' | tr '\\' '/' | sort > ../../planned
cmp ../../planned ../../actual
if hledger-flow init --dry-run 2> ../../error; then exit 1; fi
grep -q 'already a hledger-flow ledger' ../../error
if hledger-flow init import/nested --dry-run 2> ../../error; then exit 1; fi
grep -q 'inside the ledger' ../../error
test ! -e import/nested
$ sh -eu

# init starts a ledger with an example statement; a second init refuses.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
hledger-flow init > ../out.$$
grep -q '^Started a ledger in' ../out.$$
grep -q 'Next: Import 1 new or changed statement' ../out.$$
rm ../out.$$
test -d import
if hledger-flow init 2> ../err.$$; then exit 1; fi
grep -q 'is already a hledger-flow ledger' ../err.$$
rm ../err.$$
$ sh -eu

# Init supplies common commodities, units and account types.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
hledger-flow init >/dev/null
head -n 1 directives.journal | tr -d '\r' | grep -Fxq '; Ledger-wide directives go here. https://hledger.org/dev/hledger.html#directives'
grep -Eq '^commodity .* USD +; alias: ' directives.journal
grep -Eq '^commodity .* BTC +; alias: 100000000 SAT' directives.journal
grep -Eq '^commodity .* SAT$' directives.journal
if grep -q 'assets:mybank:checking' directives.journal; then exit 1; fi
hledger --no-conf -f directives.journal accounts --types | tr -d '\r' | awk '{ print $1, $4 }'
$ sh -eu
assets A
assets:bank C
assets:cash C
liabilities L
equity E
equity:conversion V
equity:unrealised-gain U
revenues R
revenues:gain G
expenses X

# The yearly price index includes separate files for both starter pairs.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
year=$(date +%Y)
price_dir="prices/$year"
hledger-flow init >/dev/null
tr -d '\r' < "$price_dir/prices.journal" | sed -n '/^[^;]/p'
hledger-flow import >/dev/null
hledger --no-conf -f all-years.journal prices > loaded-prices
test ! -s loaded-prices
grep -Fxq "; P $year-01-01 EUR 1.10 USD" "$price_dir/EUR-USD.prices"
grep -Fxq "; P $year-01-01 BTC 99000.00 USD" "$price_dir/BTC-USD.prices"
for pair in EUR-USD BTC-USD; do
    file="$price_dir/$pair.prices"
    test -s "$file"
    sed 's/^; P /P /' "$file" > updated-prices
    mv updated-prices "$file"
done
hledger --no-conf -f all-years.journal prices > loaded-prices
awk '{ print $1, $3, $NF }' loaded-prices | LC_ALL=C sort
$ sh -eu
include EUR-USD.prices
include BTC-USD.prices
P BTC USD
P EUR USD

# Init supplies editable, valid manual and balance examples at every supported level.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
year=$(date +%Y)
export USER=me USERNAME=me
account=import/me/mybank/checking
hledger-flow init >/dev/null
for file in directives.journal $(find import prices -type f); do
    case "$file" in
        *.csv) grep -Fq 'Generated by hledger-flow init as a starter.' "$file" ;;
        *) head -n 2 "$file" | grep -q '^[#;] Generated by hledger-flow init as a starter.' ;;
    esac
done
for file in directives.journal "prices/$year/prices.journal"; do
    grep -Fq 'This file is optional. If absent, hledger-flow omits it from the include files it maintains.' "$file"
done
for file in "prices/$year/EUR-USD.prices" "prices/$year/BTC-USD.prices"; do
    grep -Fq 'Remove its include line from prices.journal to omit the pair.' "$file"
done
hledger-flow import >/dev/null
hledger --no-conf -f all-years.journal descriptions
enable_example() {
    sed -n -e 's/^; \([0-9].*\)$/\1/p' -e 's/^; \(    .*\)$/\1/p' "$1" > active-example
    test -s active-example
    mv active-example "$1"
}
for level in import import/me import/me/mybank "$account"; do
    index="$level/$year-include.journal"
    grep -Fxq '### Generated by hledger-flow - DO NOT EDIT ###' "$index"
    sed -n '/^include /p' "$index" | sed "s/$year/YEAR/g"
    for phase in pre post; do
        file="$level/_manual_/$year/$phase-import.journal"
        grep -q 'https://hledger-flow.github.io/go/manual-journals/' "$file"
        grep -Fq 'This file is optional. If absent, hledger-flow omits it from the include files it maintains.' "$file"
        cp "$file" starter-example
        enable_example "$file"
        hledger --no-conf -f all-years.journal check
        mv starter-example "$file"
    done
done
for phase in opening closing; do
    file="$account/$year-$phase.journal"
    grep -q 'https://hledger-flow.github.io/go/balances/' "$file"
    grep -Fq 'This file is optional. If absent, hledger-flow omits it from the include files it maintains.' "$file"
    enable_example "$file"
done
hledger --no-conf -f all-years.journal check
hledger --no-conf -f all-years.journal descriptions
rm "$account/_manual_/$year/post-import.journal" "$account/$year-closing.journal" \
   directives.journal "prices/$year/prices.journal"
hledger-flow import >/dev/null
if grep -E 'include .*([/-]closing|post-import)\.journal' "$account/$year-include.journal"; then exit 1; fi
if grep -F 'prices.journal' "import/$year-include.journal"; then exit 1; fi
if grep -F 'directives.journal' all-years.journal; then exit 1; fi
hledger --no-conf -f all-years.journal check
$ sh -eu
Example purchase
Example refund
include _manual_/YEAR/pre-import.journal
include me/YEAR-include.journal
include ../prices/YEAR/prices.journal
include _manual_/YEAR/post-import.journal
include _manual_/YEAR/pre-import.journal
include mybank/YEAR-include.journal
include _manual_/YEAR/post-import.journal
include _manual_/YEAR/pre-import.journal
include checking/YEAR-include.journal
include _manual_/YEAR/post-import.journal
include _manual_/YEAR/pre-import.journal
include YEAR-opening.journal
include 3-journal/YEAR/hledger-flow-example.journal
include _manual_/YEAR/post-import.journal
include YEAR-closing.journal
Checking closing balance
Checking opening balance
Example purchase
Example refund

# Init uses the current user and status guides adapting the example in place.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
export USER=alex USERNAME=alex
year=$(date +%Y)
hledger-flow init > init.out
grep -Fq 'Example account: import/alex/mybank/checking' init.out
test -f "import/alex/mybank/checking/1-in/$year/hledger-flow-example.csv"
hledger-flow import >/dev/null
hledger-flow report >/dev/null
USER=someone-else USERNAME=someone-else hledger-flow status --json | jq -e '
    .next.summary == "Adapt the example account to your ledger"
    and (.next.detail | join(" ") | contains("import/alex/mybank/checking") and contains("1-in/") and contains("<bank>-<account>.rules"))
' >/dev/null
mv import/alex import/household
mv import/household/mybank import/household/creditunion
mv import/household/creditunion/checking import/household/creditunion/savings
account=import/household/creditunion/savings
rm "$account/1-in/$year/hledger-flow-example.csv" "$account/mybank-checking.rules"
printf 'Date,Description,Amount\n%s-01-03,First real statement,10.00\n' "$year" > "$account/1-in/$year/statement.csv"
printf 'skip 1\nfields date, description, amount\ncurrency USD\naccount1 assets:creditunion:savings\naccount2 revenues:interest\n' > "$account/creditunion-savings.rules"
hledger-flow import >/dev/null
hledger-flow report >/dev/null
hledger --no-conf -f all-years.journal descriptions
unset USER USERNAME
hledger-flow init fallback >/dev/null
test -d fallback/import/me/mybank/checking
USER=../outside USERNAME=../outside hledger-flow init invalid >/dev/null
test -d invalid/import/me/mybank/checking
USER=NUL USERNAME=NUL hledger-flow init reserved >/dev/null
test -d reserved/import/me/mybank/checking
USER='name;suffix' USERNAME='name;suffix' hledger-flow init comment >/dev/null
test -d comment/import/me/mybank/checking
USER='~name' USERNAME='~name' hledger-flow init tilde >/dev/null
test -d tilde/import/me/mybank/checking
$ sh -eu
First real statement

# The rules template, saved as suggested, imports the statement.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
mkdir -p import/me/mybank/checking/1-in/2026
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > import/me/mybank/checking/1-in/2026/jan.csv
hledger-flow status --rules-template me/mybank/checking > import/me/mybank/checking/mybank-checking.rules
hledger-flow import > /dev/null
hledger -f all-years.journal balance --flat --no-total --format '%(account) %(total)'
$ sh -eu
assets:mybank:checking -3.50
expenses:unknown 3.50

# The rules starter skips init's sample when the account has a real statement,
# even an older one.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
USER=me USERNAME=me hledger-flow init > /dev/null
mv import/me/mybank import/me/kudu
mv import/me/kudu/checking import/me/kudu/creditcard
rm import/me/kudu/creditcard/mybank-checking.rules
mkdir -p import/me/kudu/creditcard/1-in/2016
printf 'Date,Payee,Amount\n2016-03-02,Store,-1.00\n' > import/me/kudu/creditcard/1-in/2016/mar.csv
hledger-flow rules me/kudu/creditcard > /dev/null
rules=import/me/kudu/creditcard/kudu-creditcard.rules
tr '\\' '/' < "$rules" | grep -Fq '1-in/2016/mar.csv'
tr -d '\r' < "$rules" | grep -Fxq 'fields date, description, amount'
$ sh -eu

# Output survives a C locale (Linux containers, cron, agent sandboxes).
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
mkdir -p import/me/mybank
printf 'Date,Desc,Amount\n' > import/me/mybank/jan.csv
LC_ALL=C LANG=C hledger-flow status | grep -q '→'
LC_ALL=C LANG=C hledger-flow status --json | grep -q '"misplaced"'
$ sh -eu

# init's change-directory suggestion handles literal special characters.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
dir="Morgan's [accounts] \$(echo example)"
hledger-flow init "$dir" > output
change=$(sed -n 's/^Change to it first: //p' output | tr -d '\r')
run_suggestion "$change; hledger-flow status --json" | jq -e --arg dir "$dir" '.baseDir | endswith($dir)' > /dev/null
$ sh -eu

# Follow the inspected ledger's rules, import, environment, and report commands from another ledger.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
target="Morgan's \$(echo example)"
owner="Jean's savings"
account="$target/import/$owner/bank/checking"
mkdir -p "$account/1-in/2026" "$target/reports" other/import
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > "$account/1-in/2026/jan.csv"
cd other
run_suggestion "$(next_command "../$target")" > rules-output
grep -q '^fields date, description, amount' "../$account/bank-checking.rules"
(cd "../$target/reports" && run_suggestion "$(next_command)") > import-output
test -s "../$account/3-journal/2026/jan.journal"
set_ledger=$(hledger-flow status "../$target" | sed -n 's/^ *For hledger, run: //p' | tr -d '\r')
run_suggestion "$set_ledger; hledger-flow status --json" | jq -e '.ledgerFile.exists' > /dev/null
export LEDGER_FILE="$(cd "../$target" && native_pwd)/all-years.journal"
run_suggestion "$(next_command "../$target")" > report-output
test -s "../$target/reports/$owner/2026/accounts.txt"
test ! -e reports
$ sh -eu

# Readable paths show the home folder as ~, and pasteable commands use "$HOME" unless the rest of the path needs quoting.
<
. ./test/shell/status-commands.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
HOME=$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")
export HOME
unset LEDGER_FILE
cd "$HOME"
export USER=me USERNAME=me
hledger-flow init 'my finances' > output
grep -qx 'Started a ledger in ~/my finances' output
change=$(sed -n 's/^Change to it first: //p' output)
test "$change" = 'cd "$HOME/my finances"'
cd 'my finances'
mkdir -p import/me/mybank/checking/1-in/2026
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > import/me/mybank/checking/1-in/2026/jan.csv
printf 'skip 1\nfields date, description, amount\naccount1 assets:checking\n' > import/me/mybank/checking/mybank-checking.rules
hledger-flow import > /dev/null
hledger-flow status > ../status-output
grep -q '^Ledger: ~/my finances ' ../status-output
if grep -q '^  Ledger ' ../status-output; then exit 1; fi
set_ledger=$(sed -n 's/^ *For hledger, run: //p' ../status-output)
test "$set_ledger" = 'export LEDGER_FILE="$HOME/my finances/all-years.journal"'
run_suggestion "$set_ledger; hledger-flow status --json" | jq -e '.ledgerFile.exists and (.baseDir | startswith("/"))' > /dev/null

mkdir -p "$HOME/original-fin"
printf '; Another ledger\n' > "$HOME/original-fin/all-years.journal"
LEDGER_FILE="$(cd "$HOME" && native_pwd)/original-fin/all-years.journal"
export LEDGER_FILE
hledger-flow status > ../status-output
grep -Fxq '  Note: LEDGER_FILE (~/original-fin/all-years.journal) does not include this ledger.' ../status-output
grep -Fxq '        For hledger, run: export LEDGER_FILE="$HOME/my finances/all-years.journal"' ../status-output
hledger-flow status --json | jq -e --arg path "$LEDGER_FILE" '.ledgerFile.value == $path' > /dev/null
hledger-flow report > ../report-output
grep -Fxq 'LEDGER_FILE (~/original-fin/all-years.journal) does not include this ledger. Reporting on all-years.journal.' ../report-output

LEDGER_FILE="$(cd "$HOME" && native_pwd)/missing.journal"
hledger-flow status > ../status-output
grep -Fq "LEDGER_FILE is set to ~/missing.journal, which doesn't exist." ../status-output
if hledger-flow report > ../report-error 2>&1; then exit 1; fi
grep -Fq "LEDGER_FILE is set to ~/missing.journal, which doesn't exist. Point it at ~/my finances/all-years.journal, or unset it." ../report-error

unset LEDGER_FILE
cd "$HOME"
hledger-flow init 'cost $5' > output
change=$(sed -n 's/^Change to it first: //p' output)
case "$change" in *HOME*) exit 1 ;; esac
run_suggestion "$change; hledger-flow status --json" | jq -e '.baseDir | endswith("cost $5")' > /dev/null
$ sh -eu

# Pasted actions keep the explicit config when invoked from another ledger.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
mkdir -p "ledger space/import/me/bank/checking/1-in/2016" caller/import
printf '2016-03-01,Fee,-5\n' > "ledger space/import/me/bank/checking/1-in/2016/march.csv"
printf 'fields date, description, amount\naccount1 assets:bank\naccount2 expenses:fees\n' > "ledger space/import/bank.rules"
cd caller
printf '2016-01-01 Other\n    assets:unrelated  999\n    equity:opening\n' > other.journal
printf '[general]\n--file other.journal\n' > hledger.conf
printf '[balance]\n--flat\n' > "clean config.conf"
for action in import report; do
    hint=$(hledger-flow --hledger-conf "clean config.conf" status "../ledger space" --json | jq -er .next.command | tr -d '\r')
    printf '%s\n' "$hint" | grep -q -- '--hledger-conf'
    run_suggestion "$hint" > "$action.log"
done
test -s "../ledger space/reports/all/2016/balance-sheet.txt"
if grep -R -q assets:unrelated "../ledger space/import/me" "../ledger space/reports"; then exit 1; fi
hledger-flow --hledger-conf "clean config.conf" status "../ledger space" > status.out
balance=$(sed -n 's/^ *Or try: //p' status.out | tr -d '\r')
printf '%s\n' "$balance" | grep -q -- '--conf'
run_suggestion "$balance" > balance.out
grep -q assets:bank balance.out
if grep -q assets:unrelated balance.out; then exit 1; fi
$ sh -eu

# Cache unrelated wrappers and invalidate after changes to a glob, file, link or selection.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
flow import
mkdir ext
printf '; external one\n' > ext/a.journal
printf '; alternate\n' > alternate
printf '; initial target\n' > initial
ln -s initial link.journal
printf 'include ext/*.journal\ninclude link.journal\n' > wrapper.journal
printf '; second wrapper\n' > second.journal
cat > counting-hledger <<'SH'
#!/bin/sh
if [ "$1" = --no-conf ] && [ "$2" = files ]; then printf 'files\n' >> calls; fi
exec hledger "$@"
SH
chmod +x counting-hledger
export LEDGER_FILE=wrapper.journal
check_status() {
    hledger-flow -H "$(pwd -P)/counting-hledger" status --json |
        jq -e '.ledgerFile.coversLedger == false' > /dev/null
}
check_status
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 1
printf '; changed\n' >> ext/a.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 2
printf '; new\n' > ext/b.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 3
unlink link.journal
ln -s alternate link.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 4
export LEDGER_FILE=second.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 5
$ sh -eu

# Status names the relevant config line and hides an unsafe standalone hint.
<
. ./test/shell/setup.sh
flow import
printf '2016-01-01 Other\n    assets:unrelated  99\n    equity:opening\n' > other.journal
cp "$inbox/march.csv" "$inbox/april.csv"
printf '[print]\n-f other.journal\n' > hledger.conf
hledger-flow status --json | jq -e '.next.command == null and (.next.detail | join(" ") | contains("line 2 [print]"))' > /dev/null
printf '[balance]\n-fother.journal\n' > hledger.conf
hledger-flow status --json | jq -e '.next.command == "hledger-flow import" and (.ledgerFileNote | contains("Or try:") | not)' > /dev/null
rm "$inbox/april.csv"
hledger-flow status --json | jq -e '.next.command == null and (.next.detail | join(" ") | contains("line 2 [balance]")) and (.ledgerFileNote | contains("Or try:") | not)' > /dev/null
$ sh -eu

# Headerless starters identify Wells Fargo, dotted dates and timestamps.
<
. ./test/shell/setup.sh
rm "$inbox/march.csv"
account=import/sm/wf/bchecking
inbox=$account/1-in/2026
mkdir -p "$inbox"
rules=$account/wf-bchecking.rules
printf '1/13/2026,-4.50,*,,COFFEE SHOP\n01/03/2026,-6.75,*,,BOOK SHOP\n1/3/2026,-7.50,*,,GROCERY SHOP\n' > "$inbox/november.csv"
flow rules sm/wf/bchecking
grep -Fq 'fields date, amount, column3, column4, description' "$rules"
if grep -q '^skip' "$rules"; then exit 1; fi
flow import
grep -q '^date-format %-m/%-d/%Y' "$rules"
journal=$account/3-journal/2026/november.journal
grep -q '^2026-01-13 COFFEE SHOP' "$journal"
grep -q '^2026-01-03 BOOK SHOP' "$journal"
grep -q '^2026-01-03 GROCERY SHOP' "$journal"
grep -Eq 'assets:wf:bchecking +(-4\.50|-4\.5)' "$journal"
printf '31.12.2026,COFFEE SHOP,-4.50\n3.1.2026,BOOK SHOP,-6.75\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
flow import
grep -Fq 'date-format %-d.%-m.%Y' "$rules"
grep -q '^2026-12-31 COFFEE SHOP' "$journal"
grep -q '^2026-01-03 BOOK SHOP' "$journal"
grep -Eq 'assets:wf:bchecking +(-4\.50|-4\.5)' "$journal"
printf '2026-12-31 08:00,COFFEE SHOP,-4.50\n2026-1-3 09:10,BOOK SHOP,-6.75\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
flow import
grep -Fq 'date-format %Y-%-m-%-d %H:%M' "$rules"
grep -q '^2026-12-31 COFFEE SHOP' "$journal"
grep -q '^2026-01-03 BOOK SHOP' "$journal"
grep -Eq 'assets:wf:bchecking +(-4\.50|-4\.5)' "$journal"
printf '03/04/2026,COFFEE SHOP,-4.50\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
grep -q '^# date-format' "$rules"
if grep -q '^date-format' "$rules"; then exit 1; fi
$ sh -eu

# The rules command writes the suggested default without replacing other files.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
ledger="target ledger"
acct=import/sm/wf/bchecking
inbox="$ledger/$acct/1-in/2026"
mkdir -p "$inbox" caller/import
printf 'Date,Desc,Amount\n2026-01-01,Shop,-5\n' > "$inbox/january.csv"
printf '2026-02-01,Special,-9\n' > "$inbox/february_rfo-card.csv"
printf 'fields date, description, amount\naccount1 assets:card\naccount2 expenses:special\n' > "$ledger/$acct/rfo-card.rules"
cp "$ledger/$acct/rfo-card.rules" before-override
cd caller
hledger-flow status --rules-template sm/wf/bchecking "../$ledger" > starter
run_suggestion "$(next_command "../$ledger")" > wrote
path="../$ledger/$acct/wf-bchecking.rules"
cmp starter "$path"
grep -q '^Created .*wf-bchecking.rules' wrote
grep -q '^Edit it: check the fields line and the account names.' wrote
cmp "../before-override" "../$ledger/$acct/rfo-card.rules"
errfile="$(pwd)/duplicate.err"
(cd "../$ledger/$acct/1-in/2026" && if hledger-flow rules sm/wf/bchecking >/dev/null 2>"$errfile"; then exit 1; else grep -q 'already exists' "$errfile"; grep -q -- '--rules-template' "$errfile"; fi)
cmp starter "$path"
hledger-flow import "../$ledger" > imported
grep -q 'expenses:special' "../$ledger/$acct/3-journal/2026/february_rfo-card.journal"
if hledger-flow rules sm/wf/not-found "../$ledger" > out 2> err; then exit 1; fi
grep -q 'No statements found' err
test ! -d "../$ledger/import/sm/wf/not-found"
$ sh -eu

# Empty-ledger setup commands work at the root and from another directory.
<
. ./test/shell/status-commands.sh
. ./test/shell/setup.sh
mkdir -p 'ledger one/import' 'ledger two/import'
export USER=alex USERNAME=alex
year=$(date +%Y)
example="import/alex/mybank/checking/1-in/$year"
command_from_json() {
    hledger-flow status "$@" --json | jq -er '.next.detail[] | select(startswith("Change the names, then run: ")) | sub("^Change the names, then run: "; "")' | tr -d '\r'
}
(
  cd 'ledger one'
  suggestion=$(command_from_json)
  test "$suggestion" = "$(hledger-flow status | sed -n 's/^ *Change the names, then run: //p' | tr -d '\r')"
  run_suggestion "$suggestion" >/dev/null
  test -d "$example"
)
run_suggestion "$(command_from_json 'ledger two')" >/dev/null
test -d "ledger two/$example"
printf '%s-01-01,Shop,-5\n' "$year" > "ledger two/$example/statement.csv"
hledger-flow status 'ledger two' --json | jq -e '.next.command | contains("hledger-flow rules alex/mybank/checking")' > /dev/null
$ sh -eu

# Reuse a local rules entry point while leaving its included helper in place.
<
. ./test/shell/status-commands.sh
. ./test/shell/setup.sh
rm "$inbox/march.csv"
account=import/sm/wf/bchecking
inbox=$account/1-in/2026
mkdir -p "$inbox"
printf '2026-01-02,Shop,-7\n' > "$inbox/january.csv"
printf 'fields date, description, amount\naccount1 assets:wf:bchecking\ninclude wf-common.rules\n' > "$account/wf-checking.rules"
printf 'account2 expenses:from-included-rules\n' > "$account/wf-common.rules"
cp "$account/wf-common.rules" helper
cp "$account/wf-checking.rules" original
printf 'fields date, description, amount\n' > "$account/other.rules"
hledger-flow status --json | jq -e '.next.command == null and (.next.summary | contains("wf-bchecking.rules")) and (.next.detail | join(" ") | contains("wf-checking.rules") and contains("other.rules"))' > /dev/null
rm "$account/other.rules"
command=$(next_command)
printf '%s\n' "$command" | tr '\\' '/' | grep -Eq "^(mkdir -p|New-Item -ItemType Directory -Force -Path) '?import/"
(cd "$account" && hledger-flow status) | tr '\\' '/' | grep -Fq "Next: Rename $account/wf-checking.rules to $account/wf-bchecking.rules"
printf unchanged > "$account/wf-bchecking.rules"
if run_suggestion "$command" > out 2> err; then exit 1; fi
test "$(cat "$account/wf-bchecking.rules")" = unchanged
cmp "$account/wf-checking.rules" original
rm "$account/wf-bchecking.rules"
run_suggestion "$command"
mv "$account/wf-bchecking.rules" "$account/wf-checking.rules"
(cd "$account" && run_suggestion "$(next_command)")
cmp helper "$account/wf-common.rules"
cmp original "$account/wf-bchecking.rules"
test ! -e "$account/wf-checking.rules"
flow import
grep -q expenses:from-included-rules "$account/3-journal/2026/january.journal"
$ sh -eu

# Init builds a usable example and preserves pre-existing directives and prices.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
year=$(date +%Y)
mkdir -p "prices/$year"
printf '; Existing directives\n' > directives.journal
printf '; Existing prices\n' > "prices/$year/prices.journal"
printf '; Existing EUR-USD prices\n' > "prices/$year/EUR-USD.prices"
cp directives.journal original-directives
cp "prices/$year/prices.journal" original-prices
cp "prices/$year/EUR-USD.prices" original-pair
export USER=me USERNAME=me
acct=import/me/mybank/checking
rules="$acct/mybank-checking.rules"
sample="$acct/1-in/$year/hledger-flow-example.csv"
manual="import/_manual_/$year/post-import.journal"
hledger-flow init > init.out
grep -q '^Next: Import 1 new or changed statement' init.out
grep -q 'Kept existing .*directives.journal' init.out
grep -q 'Kept existing .*prices.journal' init.out
cmp directives.journal original-directives
cmp "prices/$year/prices.journal" original-prices
cmp "prices/$year/EUR-USD.prices" original-pair
test -s "$sample"
test -s "$rules"
test -s "$manual"
test -s "import/_manual_/$year/pre-import.journal"
test -s "import/me/_manual_/$year/pre-import.journal"
test ! -e "$acct/preprocess"
test ! -e "$acct/construct"
run_suggestion "$(next_command)" > import.out
grep -q '^Imported 1 statement' import.out
run_suggestion "$(next_command)" > report.out
hledger-flow status --json | jq -e '.reportsCurrent and .review.unknownTransactions.count == 0 and .review.transferAccounts.count == 0 and (.next.summary == "Adapt the example account to your ledger")' > /dev/null
hledger -f all-years.journal balance --monthly --no-total expenses:example > monthly
hledger -f all-years.journal balance --quarterly --no-total expenses:example > quarterly
if grep -q 'expenses:example *||' monthly quarterly; then exit 1; fi
touch "$acct/.keep"
hledger-flow status --json | jq -e '.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not' > /dev/null
rm "$acct/.keep"
cp "$rules" original-rules
printf '# User rule edit\n' >> "$rules"
hledger-flow import > import.out
hledger-flow report > report.out
hledger-flow status --json | jq -e '.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not' > /dev/null
mv original-rules "$rules"
cp "$sample" original-sample
printf '\n' >> "$sample"
hledger-flow import > import.out
hledger-flow report > report.out
hledger-flow status --json | jq -e '.reportsCurrent and (.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not)' > /dev/null
mv original-sample "$sample"
account_manual="$acct/_manual_/$year/post-import.journal"
cp "$account_manual" original-manual
printf '; Account-level user edit\n' >> "$account_manual"
hledger-flow import > import.out
hledger-flow report > report.out
hledger-flow status --json | jq -e '.reportsCurrent and (.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not)' > /dev/null
mv original-manual "$account_manual"
closing="$acct/$year-closing.journal"
cp "$closing" original-closing
printf '; Closing balance edit\n' >> "$closing"
hledger-flow report > report.out
hledger-flow status --json | jq -e '.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not' > /dev/null
mv original-closing "$closing"
touch "$acct/preprocess"
hledger-flow status --json | jq -e '.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not' > /dev/null
rm "$acct/preprocess"
mkdir -p import/me/otherbank
hledger-flow status --json | jq -e '.next.detail | join(" ") | contains("Rename the owner, bank and account folders") | not' > /dev/null
rmdir import/me/otherbank
hledger-flow import > import.out
hledger-flow report > report.out
hledger-flow status --json | jq -e '.next.detail | join(" ") | contains("Rename the owner, bank and account folders")' > /dev/null
printf '%s-01-03 User manual entry\n    assets:manual  11 USD\n    equity:opening balances\n' "$year" > "$manual"
rm -r import/me reports/me
hledger-flow import > import.out
hledger-flow report > report.out
test ! -e import/me
test ! -e reports/me
grep -R -q assets:manual reports/all
if grep -R -q hledger-flow-example import; then exit 1; fi
if grep -q 'reports.*me.*unknown-transactions' .hledger-flow/cache/reports.json; then exit 1; fi
$ sh -eu

# After sample deletion, the starter declarations and comment-only manual journals leave first-statement guidance.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
export USER=me USERNAME=me
year=$(date +%Y)
hledger-flow init >/dev/null
hledger-flow import >/dev/null
hledger-flow report >/dev/null
rm -r import/me reports/me
hledger-flow import >/dev/null
first_statement() {
    hledger-flow status | grep -q '^Next: Put your first statement in import/<owner>/<bank>/<account>/1-in/<year>/'
    hledger-flow status --json | jq -e '.manualJournals == 2 and (.accounts | length == 0) and (.next.summary | startswith("Put your first statement in"))' > /dev/null
}
first_statement
hledger-flow report >/dev/null
first_statement
cp directives.journal starter-directives
printf '%s-01-03 Manual opening\n    assets:checking  10 USD\n    equity:opening balances\n' "$year" >> directives.journal
hledger-flow status --json | jq -e '.next.command == "hledger-flow report"' > /dev/null
mv starter-directives directives.journal
printf '%s-01-03 Manual deposit\n    assets:checking  10 USD\n    income:salary\n' "$year" >> "import/_manual_/$year/post-import.journal"
hledger-flow status --json | jq -e '.manualJournals == 2 and .next.command == "hledger-flow report"' > /dev/null
$ sh -eu

# The first real statement gets its own owner while the sample account exists.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
year=$(date +%Y)
export USER=me USERNAME=me
sample="import/me/mybank/checking/1-in/$year/hledger-flow-example.csv"
real="import/personal/mybank/checking/1-in/$year"
hledger-flow init >/dev/null
hledger-flow import >/dev/null
hledger-flow report >/dev/null
cp "$sample" original-sample
setup_command() {
    hledger-flow status --json | jq -er '.next.detail[] | select(startswith("Change the names, then run: ")) | sub("^Change the names, then run: "; "")' | tr -d '\r'
}
touch import/me/mybank/checking/.keep
suggestion=$(setup_command)
test "$suggestion" = "$(hledger-flow status | sed -n 's/^ *Change the names, then run: //p' | tr -d '\r')"
run_suggestion "$suggestion" >/dev/null
test -d "$real"
printf 'Date,Description,Amount\n%s-01-03,Real purchase,-9.50\n' "$year" > "$real/statement.csv"
run_suggestion "$(next_command)" >/dev/null
hledger-flow import >/dev/null
grep -q "^$year-01-03 Real purchase" "import/personal/mybank/checking/3-journal/$year/statement.journal"
cmp original-sample "$sample"
$ sh -eu

# A failed init can be retried without an incomplete import tree.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
year=$(date +%Y)
export USER=me USERNAME=me
mkdir -p "prices/$year/prices.journal"
if hledger-flow init > out 2> err; then exit 1; fi
grep -q 'prices.journal' err
test ! -e import
rmdir "prices/$year/prices.journal"
hledger-flow init > out
test -s "prices/$year/prices.journal"
test -s "import/me/mybank/checking/mybank-checking.rules"
$ sh -eu
