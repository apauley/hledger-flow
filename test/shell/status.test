# Bare invocation in an empty folder suggests init.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
hledger-flow
$ sh -eu
This folder is empty. Run `hledger-flow init` to start your ledger here.

# Bare invocation in an unrelated folder shows commands and writes nothing.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
touch notes.txt
hledger-flow > ../out.$$
grep -q '^Commands:' ../out.$$
grep -q 'No hledger-flow ledger here or in any parent folder' ../out.$$
rm ../out.$$
test "$(ls)" = notes.txt
$ sh -eu

# First-time path: misplaced CSV, missing rules, import, LEDGER_FILE, report; never coloured when piped.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
mkdir -p import/me/mybank
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > import/me/mybank/jan.csv
hledger-flow status | grep -q 'Next: Move 1 file to where hledger-flow looks'
hledger-flow status --json | jq -e '.misplaced[0].suggestion | split("\\") | join("/") == "import/me/mybank/<account>/1-in/2026/jan.csv"' > /dev/null
mkdir -p import/me/mybank/checking/1-in/2026 && mv import/me/mybank/jan.csv import/me/mybank/checking/1-in/2026/
hledger-flow status --json | jq -e '.next.command == "hledger-flow rules me/mybank/checking"' > /dev/null
printf 'skip 1\nfields date, description, amount\naccount1 assets:checking\n' > import/me/mybank/checking/mybank-checking.rules
hledger-flow status --json | jq -e '.next.command == "hledger-flow import"' > /dev/null
hledger-flow import > /dev/null
case "$(uname -s)" in
    MINGW*|MSYS*) prefix='$env:LEDGER_FILE = ' ;;
    *) prefix='export LEDGER_FILE=' ;;
esac
hledger-flow status --json | jq -e --arg prefix "$prefix" '(.next.command == "hledger-flow report") and (.ledgerFileNote | contains($prefix))' > /dev/null
export LEDGER_FILE="$(native_pwd)/all-years.journal"
hledger-flow status > ../out.$$
grep -q 'Run: hledger-flow report' ../out.$$
if grep -q "$(printf '\033')" ../out.$$; then exit 1; fi
rm ../out.$$
$ sh -eu

# Suggest prices for a multi-commodity ledger until it has a market price.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
mkdir -p import/me/_manual_/2026 prices/2026
journal=import/me/_manual_/2026/pre-import.journal
prices=prices/2026/prices.journal
printf '2026-01-01 Opening\n    assets:checking  10 EUR\n    equity:opening balances\n' > "$journal"
printf '; Prices go here\n' > "$prices"
export LEDGER_FILE="$(native_pwd)/all-years.journal"
hledger-flow import > /dev/null
hledger-flow status | grep -q '^Next: Generate reports'
printf '\n2026-01-02 Opening\n    assets:savings  10 USD\n    equity:opening balances\n' >> "$journal"
unset LEDGER_FILE
hledger-flow status --json | jq -e '.next.docs == "https://hledger-flow.github.io/go/price-files/"' > /dev/null
hledger-flow status | grep -q '^Next: Add market prices'
printf 'P 2026-01-01 USD 0.90 EUR\n' >> "$prices"
export LEDGER_FILE="$(native_pwd)/all-years.journal"
hledger-flow status | grep -q '^Next: Generate reports'
$ sh -eu

# Status works from deep inside an account and in a folder with spaces.
<
. ./test/shell/status-commands.sh
dir="$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")/my finances"
mkdir -p "$dir/import/me/mybank/checking/1-in/2026" && cd "$dir"
printf 'Date,Desc,Amount\n' > import/me/mybank/checking/1-in/2026/jan.csv
hledger-flow status > ../top
(cd import/me/mybank/checking/1-in/2026 && hledger-flow status) > ../deep
sed '/^Next:/,$d' ../top > ../top-status
sed '/^Next:/,$d' ../deep > ../deep-status
cmp ../top-status ../deep-status
if grep -q 'Changing runDir' ../deep; then exit 1; fi
test "$(hledger-flow status --json | jq -r .baseDir | tr -d '\r')" = "$(native_pwd)"
$ sh -eu

# init starts a ledger and points at the first statement; a second init refuses.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
hledger-flow init > ../out.$$
grep -q '^Started a ledger in' ../out.$$
grep -q 'Next: Put your first statement in import/<owner>/<bank>/<account>/1-in/<year>/' ../out.$$
rm ../out.$$
test -d import
if hledger-flow init 2> ../err.$$; then exit 1; fi
grep -q 'is already a hledger-flow ledger' ../err.$$
rm ../err.$$
$ sh -eu

# The rules template, saved as suggested, imports the statement.
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
mkdir -p import/me/mybank/checking/1-in/2026
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > import/me/mybank/checking/1-in/2026/jan.csv
hledger-flow status --rules-template me/mybank/checking > import/me/mybank/checking/mybank-checking.rules
hledger-flow import > /dev/null
hledger -f all-years.journal balance --flat --no-total --format '%(account) %(total)'
$ sh -eu
assets:mybank:checking -3.50
expenses:unknown 3.50

# Output survives a C locale (Linux containers, cron, agent sandboxes).
<
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
mkdir -p import/me/mybank
printf 'Date,Desc,Amount\n' > import/me/mybank/jan.csv
LC_ALL=C LANG=C hledger-flow status | grep -q '→'
LC_ALL=C LANG=C hledger-flow status --json | grep -q '"misplaced"'
$ sh -eu

# init's change-directory suggestion handles literal special characters.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
dir="Morgan's [accounts] \$(echo example)"
hledger-flow init "$dir" > output
change=$(sed -n 's/^Change to it first: //p' output | tr -d '\r')
run_suggestion "$change; hledger-flow status --json" | jq -e --arg dir "$dir" '.baseDir | endswith($dir)' > /dev/null
$ sh -eu

# Follow the inspected ledger's rules, import, environment, and report commands from another ledger.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
target="Morgan's \$(echo example)"
owner="Jean's savings"
account="$target/import/$owner/bank/checking"
mkdir -p "$account/1-in/2026" "$target/reports" other/import
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > "$account/1-in/2026/jan.csv"
cd other
run_suggestion "$(next_command "../$target")" > rules-output
grep -q '^fields date, description, amount' "../$account/bank-checking.rules"
(cd "../$target/reports" && run_suggestion "$(next_command)") > import-output
test -s "../$account/3-journal/2026/jan.journal"
set_ledger=$(hledger-flow status "../$target" | sed -n 's/^ *For hledger, run: //p' | tr -d '\r')
run_suggestion "$set_ledger; hledger-flow status --json" | jq -e '.ledgerFile.exists' > /dev/null
export LEDGER_FILE="$(cd "../$target" && native_pwd)/all-years.journal"
run_suggestion "$(next_command "../$target")" > report-output
test -s "../$target/reports/$owner/2026/accounts.txt"
test ! -e reports
$ sh -eu

# Readable paths show the home folder as ~, and pasteable commands use "$HOME" unless the rest of the path needs quoting.
<
. ./test/shell/status-commands.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
HOME=$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")
export HOME
unset LEDGER_FILE
cd "$HOME"
hledger-flow init 'my finances' > output
grep -qx 'Started a ledger in ~/my finances' output
change=$(sed -n 's/^Change to it first: //p' output)
test "$change" = 'cd "$HOME/my finances"'
cd 'my finances'
mkdir -p import/me/mybank/checking/1-in/2026
printf 'Date,Desc,Amount\n2026-01-02,Coffee,-3.50\n' > import/me/mybank/checking/1-in/2026/jan.csv
printf 'skip 1\nfields date, description, amount\naccount1 assets:checking\n' > import/me/mybank/checking/mybank-checking.rules
hledger-flow import > /dev/null
hledger-flow status > ../status-output
grep -q '^Ledger: ~/my finances ' ../status-output
if grep -q '^  Ledger ' ../status-output; then exit 1; fi
set_ledger=$(sed -n 's/^ *For hledger, run: //p' ../status-output)
test "$set_ledger" = 'export LEDGER_FILE="$HOME/my finances/all-years.journal"'
run_suggestion "$set_ledger; hledger-flow status --json" | jq -e '.ledgerFile.exists and (.baseDir | startswith("/"))' > /dev/null
cd "$HOME"
hledger-flow init 'cost $5' > output
change=$(sed -n 's/^Change to it first: //p' output)
case "$change" in *HOME*) exit 1 ;; esac
run_suggestion "$change; hledger-flow status --json" | jq -e '.baseDir | endswith("cost $5")' > /dev/null
$ sh -eu

# Pasted actions keep the explicit config when invoked from another ledger.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
mkdir -p "ledger space/import/me/bank/checking/1-in/2016" caller/import
printf '2016-03-01,Fee,-5\n' > "ledger space/import/me/bank/checking/1-in/2016/march.csv"
printf 'fields date, description, amount\naccount1 assets:bank\naccount2 expenses:fees\n' > "ledger space/import/bank.rules"
cd caller
printf '2016-01-01 Other\n    assets:unrelated  999\n    equity:opening\n' > other.journal
printf '[general]\n--file other.journal\n' > hledger.conf
printf '[balance]\n--flat\n' > "clean config.conf"
for action in import report; do
    hint=$(hledger-flow --hledger-conf "clean config.conf" status "../ledger space" --json | jq -er .next.command | tr -d '\r')
    printf '%s\n' "$hint" | grep -q -- '--hledger-conf'
    run_suggestion "$hint" > "$action.log"
done
test -s "../ledger space/reports/all/2016/balance-sheet.txt"
if grep -R -q assets:unrelated "../ledger space/import/me" "../ledger space/reports"; then exit 1; fi
hledger-flow --hledger-conf "clean config.conf" status "../ledger space" > status.out
balance=$(sed -n 's/^ *Or try: //p' status.out | tr -d '\r')
printf '%s\n' "$balance" | grep -q -- '--conf'
run_suggestion "$balance" > balance.out
grep -q assets:bank balance.out
if grep -q assets:unrelated balance.out; then exit 1; fi
$ sh -eu

# Cache unrelated wrappers and invalidate after changes to a glob, file, link or selection.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
flow import
mkdir ext
printf '; external one\n' > ext/a.journal
printf '; alternate\n' > alternate
printf '; initial target\n' > initial
ln -s initial link.journal
printf 'include ext/*.journal\ninclude link.journal\n' > wrapper.journal
printf '; second wrapper\n' > second.journal
cat > counting-hledger <<'SH'
#!/bin/sh
if [ "$1" = --no-conf ] && [ "$2" = files ]; then printf 'files\n' >> calls; fi
exec hledger "$@"
SH
chmod +x counting-hledger
export LEDGER_FILE=wrapper.journal
check_status() {
    hledger-flow -H "$(pwd -P)/counting-hledger" status --json |
        jq -e '.ledgerFile.coversLedger == false' > /dev/null
}
check_status
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 1
printf '; changed\n' >> ext/a.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 2
printf '; new\n' > ext/b.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 3
unlink link.journal
ln -s alternate link.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 4
export LEDGER_FILE=second.journal
check_status
test "$(wc -l < calls | tr -d ' ')" -eq 5
$ sh -eu

# Status names the relevant config line and hides an unsafe standalone hint.
<
. ./test/shell/setup.sh
flow import
printf '2016-01-01 Other\n    assets:unrelated  99\n    equity:opening\n' > other.journal
cp "$inbox/march.csv" "$inbox/april.csv"
printf '[print]\n-f other.journal\n' > hledger.conf
hledger-flow status --json | jq -e '.next.command == null and (.next.detail | join(" ") | contains("line 2 [print]"))' > /dev/null
printf '[balance]\n-fother.journal\n' > hledger.conf
hledger-flow status --json | jq -e '.next.command == "hledger-flow import" and (.ledgerFileNote | contains("Or try:") | not)' > /dev/null
rm "$inbox/april.csv"
hledger-flow status --json | jq -e '.next.command == null and (.next.detail | join(" ") | contains("line 2 [balance]")) and (.ledgerFileNote | contains("Or try:") | not)' > /dev/null
$ sh -eu

# Headerless starters identify Wells Fargo, dotted dates and timestamps.
<
. ./test/shell/setup.sh
rm "$inbox/march.csv"
account=import/sm/wf/bchecking
inbox=$account/1-in/2026
mkdir -p "$inbox"
rules=$account/wf-bchecking.rules
printf '11/14/2026,-4.50,*,,COFFEE SHOP\n11/15/2026,-6.75,*,,BOOK SHOP\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
grep -Fq 'fields date, amount, column3, column4, description' "$rules"
grep -q '^date-format %m/%d/%Y' "$rules"
if grep -q '^skip' "$rules"; then exit 1; fi
flow import
journal=$account/3-journal/2026/november.journal
grep -q '^2026-11-14 COFFEE SHOP' "$journal"
grep -Eq 'assets:wf:bchecking +(-4\.50|-4\.5)' "$journal"
printf '31.12.2026,COFFEE SHOP,-4.50\n30.12.2026,BOOK SHOP,-6.75\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
grep -q '^date-format %d.%m.%Y' "$rules"
flow import
grep -q '^2026-12-31 COFFEE SHOP' "$journal"
grep -Eq 'assets:wf:bchecking +(-4\.50|-4\.5)' "$journal"
printf '2026-12-31 08:00,COFFEE SHOP,-4.50\n2026-12-30 09:10,BOOK SHOP,-6.75\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
grep -q '^date-format %Y-%m-%d %H:%M' "$rules"
flow import
grep -q '^2026-12-31 COFFEE SHOP' "$journal"
grep -Eq 'assets:wf:bchecking +(-4\.50|-4\.5)' "$journal"
printf '03/04/2026,COFFEE SHOP,-4.50\n' > "$inbox/november.csv"
hledger-flow status --rules-template sm/wf/bchecking > "$rules"
grep -q '^# date-format' "$rules"
if grep -q '^date-format' "$rules"; then exit 1; fi
$ sh -eu

# The rules command writes the suggested default without replacing other files.
<
. ./test/shell/status-commands.sh
cd "$(mktemp -d "${TMPDIR:-/tmp}/hledger-flow.XXXXXXXX")"
unset LEDGER_FILE
ledger="target ledger"
acct=import/sm/wf/bchecking
inbox="$ledger/$acct/1-in/2026"
mkdir -p "$inbox" caller/import
printf 'Date,Desc,Amount\n2026-01-01,Shop,-5\n' > "$inbox/january.csv"
printf '2026-02-01,Special,-9\n' > "$inbox/february_rfo-card.csv"
printf 'fields date, description, amount\naccount1 assets:card\naccount2 expenses:special\n' > "$ledger/$acct/rfo-card.rules"
cp "$ledger/$acct/rfo-card.rules" before-override
cd caller
hledger-flow status --rules-template sm/wf/bchecking "../$ledger" > starter
run_suggestion "$(next_command "../$ledger")" > wrote
path="../$ledger/$acct/wf-bchecking.rules"
cmp starter "$path"
grep -q '^Created .*wf-bchecking.rules' wrote
grep -q '^Edit it: check the fields line and the account names.' wrote
cmp "../before-override" "../$ledger/$acct/rfo-card.rules"
errfile="$(pwd)/duplicate.err"
(cd "../$ledger/$acct/1-in/2026" && if hledger-flow rules sm/wf/bchecking >/dev/null 2>"$errfile"; then exit 1; else grep -q 'already exists' "$errfile"; grep -q -- '--rules-template' "$errfile"; fi)
cmp starter "$path"
hledger-flow import "../$ledger" > imported
grep -q 'expenses:special' "../$ledger/$acct/3-journal/2026/february_rfo-card.journal"
if hledger-flow rules sm/wf/not-found "../$ledger" > out 2> err; then exit 1; fi
grep -q 'No statements found' err
test ! -d "../$ledger/import/sm/wf/not-found"
$ sh -eu
