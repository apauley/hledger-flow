# The first statement becomes a journal and is reachable from the root ledger.
<
. ./test/shell/setup.sh
flow import
hledger -f "$journal" descriptions
hledger -f all-years.journal balance --flat --no-total --format '%(account) %(total)'
$ sh -eu
Monthly bank fee
assets:bank:cheque -5
expenses:bank-fees 5

# Sequential import writes the same journal and keeps command diagnostics on stderr.
<
. ./test/shell/setup.sh
flow import
test -s "$journal"
cp "$journal" parallel.journal
rm "$journal"
hledger-flow --sequential import > sequential.out
cmp parallel.journal "$journal"
if grep -F 'Monthly bank fee' sequential.out; then exit 1; fi
printf '%s\n' 'not-a-journal-directive' > directives.journal
if hledger-flow --sequential import > sequential.out 2> sequential.err; then exit 1; fi
grep -q 'directives\.journal:1' sequential.err
cmp parallel.journal "$journal"
$ sh -eu

# A subsequent download adds a transaction without rewriting the current journal.
<
. ./test/shell/setup.sh
flow import
printf '; retain on incremental import\n' >> "$journal"
printf '%s\n' '2016-04-01,April fee,-7' > "$inbox/april.csv"
flow import --new-files-only
grep -Fx '; retain on incremental import' "$journal"
hledger -f all-years.journal balance expenses --flat --no-total --format '%(account) %(total)'
$ sh -eu
; retain on incremental import
expenses:bank-fees 12

# Importing from an account discovers the base and leaves its sibling alone.
<
. ./test/shell/setup.sh
other=import/gawie/bogart/savings
mkdir -p "$other/1-in/2016"
cp "$inbox/march.csv" "$other/1-in/2016/"
(cd "$account" && flow import)
test ! -e "$other/3-journal/2016/march.journal"
hledger -f "$account/all-years.journal" descriptions
hledger -f all-years.journal descriptions
$ sh -eu
Monthly bank fee
Monthly bank fee

# A partial import refreshes the root ledger for a new year without processing siblings.
<
. ./test/shell/setup.sh
other=import/gawie/bogart/savings
mkdir -p "$other/1-in/2016"
printf '%s\n' '2016-02-01,Savings interest,4' > "$other/1-in/2016/interest.csv"
flow import
cp "$other/3-journal/2016/interest.journal" savings-before.journal
touch -t 201601010000 "$other/2016-include.journal" saved-time
mkdir -p "$account/1-in/2017" "$other/1-in/2017"
printf '%s\n' '2017-01-03,New year fee,-6' > "$account/1-in/2017/fee.csv"
printf '%s\n' '2017-01-04,Pending interest,5' > "$other/1-in/2017/pending.csv"
existing=import/another-owner/old-bank/closed/3-journal/2015
mkdir -p "$existing"
printf '2015-01-01 Archived fee\n    expenses:fees  2\n    assets:bank\n' > "$existing/fee.journal"
mkdir -p import/another-owner/old-bank/closed/1-in/2015
printf '%s\n' '2015-01-01,Archived fee,-2' > import/another-owner/old-bank/closed/1-in/2015/fee.csv
(cd "$account" && flow import)
test ! -e "$other/3-journal/2017/pending.journal"
cmp savings-before.journal "$other/3-journal/2016/interest.journal"
test ! "$other/2016-include.journal" -nt saved-time
hledger -f all-years.journal descriptions
$ sh -eu
Archived fee
Monthly bank fee
New year fee
Savings interest

# With no conversion rules the CLI explains why this import failed.
<
. ./test/shell/setup.sh
rm import/bogart.rules
hledger-flow import > /dev/null
$ sh -eu
>2 /couldn't find an hledger rules file/
>= 1

# A malformed directives file must be reported by hledger during import.
<
. ./test/shell/setup.sh
printf '%s\n' 'not-a-journal-directive' > directives.journal
hledger-flow import > /dev/null
$ sh -eu
>2 /directives\.journal:1/
>= 1

# A corrected download is regenerated by the same incremental import.
<
. ./test/shell/setup.sh
flow import
printf '%s\n' '2016-03-01,Corrected fee,-3' > "$inbox/march.csv"
touch -t 201603010000 "$journal"
touch -t 201603020000 "$inbox/march.csv"
flow import --new-files-only
hledger -f all-years.journal descriptions
hledger -f all-years.journal balance expenses --flat --no-total --format '%(total)'
$ sh -eu
Corrected fee
3

# A statement-specific rule classifies a special download without affecting March.
<
. ./test/shell/setup.sh
sed 's/expenses:bank-fees/expenses:groceries/' import/bogart.rules > "$account/rfo-market.rules"
printf '%s\n' '2016-04-02,Market,-30' > "$inbox/april_rfo-market.csv"
flow import
hledger -f all-years.journal balance expenses --flat --no-total --format '%(account) %(total)'
$ sh -eu
expenses:bank-fees 5
expenses:groceries 30

# Statement overrides win in account, bank, then import order, ahead of the general rules.
<
. ./test/shell/setup.sh
mv "$inbox/march.csv" "$inbox/march_rfo-market.bank.csv"
journal="$account/3-journal/2016/march_rfo-market.bank.journal"
bank=import/gawie/bogart
make_rule() { sed "s/bank-fees/$2/" import/bogart.rules > "$1"; }
make_rule "$account/rfo-market.rules" account-override
make_rule "$bank/rfo-market.rules" bank-override
make_rule import/rfo-market.rules import-override
make_rule "$account/bogart-cheque.rules" account-default
for rule in "$account/rfo-market.rules" "$bank/rfo-market.rules" import/rfo-market.rules "$account/bogart-cheque.rules" import/bogart.rules; do
    flow import
    hledger -f "$journal" accounts '^expenses:'
    rm "$rule"
done
$ sh -eu
expenses:account-override
expenses:bank-override
expenses:import-override
expenses:account-default
expenses:bank-fees

# An account named 1-in keeps its own cached CSV, journal and ledger includes.
<
. ./test/shell/setup.sh
mv "$account" import/gawie/bogart/1-in
account=import/gawie/bogart/1-in
mkdir -p "$account/2-preprocessed/2016"
printf '%s\n' '2016-03-01,From cached CSV,-5' > "$account/2-preprocessed/2016/march.csv"
flow import
hledger -f "$account/3-journal/2016/march.journal" descriptions
hledger -f all-years.journal descriptions
test ! -e import/gawie/bogart/3-journal
$ sh -eu
From cached CSV
From cached CSV

# Parallel work needs a positive batch size; sequential mode ignores the setting.
<
. ./test/shell/setup.sh
flow --sequential --batch-size 0 import
test -s "$journal"
hledger-flow --batch-size 0 import > /dev/null
$ sh -eu
>2 /--batch-size must be positive/
>= 1

# A successful import prints a one-line summary and the next step, without timings.
<
. ./test/shell/setup.sh
hledger-flow import > out
grep -qx 'Imported 1 statement for gawie/bogart/cheque.' out
grep -q '^Next: Point LEDGER_FILE at this ledger' out
if grep -q 'Collecting' out; then exit 1; fi
$ sh -eu

# A failing hledger conversion names the rules file to check and doesn't dump the whole input.
<
. ./test/shell/setup.sh
printf 'fields date, description\nskip x\n' > import/bogart.rules
if hledger-flow import 2> err; then exit 1; fi
grep -q 'Check the skip, fields and separator lines in import/bogart.rules' err
if grep -q 'Begin Error' err; then exit 1; fi
test "$(grep -c "skip's argument should be" err)" -eq 1
$ sh -eu
