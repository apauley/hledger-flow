# Exact annual and monthly amounts, with unknown and transfer reports in two years.
<
. ./test/shell/setup.sh
mkdir -p import/gawie/_manual_/2016 import/gawie/_manual_/2017
cat > import/gawie/_manual_/2016/post-import.journal <<'JOURNAL'
2016-03-02 Market
    expenses:groceries  30
    assets:cash

2016-03-03 Unknown purchase
    expenses:unknown  11
    assets:cash

2016-03-04 Transfer sent
    assets:transfer  17
    assets:bank:cheque
JOURNAL
cat > import/gawie/_manual_/2017/post-import.journal <<'JOURNAL'
2017-03-02 Later market
    expenses:groceries  300
    assets:cash

2017-03-03 Later unknown
    expenses:unknown  19
    assets:cash

2017-03-04 Later transfer
    assets:transfer  23
    assets:bank:cheque
JOURNAL
flow import
flow report --ascii-reports
for year in 2016 2017; do
    report_row "reports/gawie/$year/income-expenses.txt" expenses:groceries
    report_row "reports/gawie/$year/monthly/income-expenses.txt" expenses:groceries
    report_row "reports/all/$year/transfer-balance.txt" assets:transfer
    tail -n +3 "reports/gawie/$year/unknown-transactions.txt" > unknown.journal
    hledger -f unknown.journal descriptions
    hledger -f unknown.journal balance expenses --flat --no-total --format '%(account) %(total)'
done
report_row reports/gawie/2016/balance-sheet.txt assets:cash
report_row reports/gawie/2017/balance-sheet.txt assets:cash
tr -d '\r' < reports/gawie/2016/accounts.txt | grep -Fx expenses:bank-fees
if grep -q bank-fees reports/gawie/2017/accounts.txt; then exit 1; fi
$ sh -eu
expenses:groceries || 30
expenses:groceries || 0 0 30 0 0 0 0 0 0 0 0 0
assets:transfer || 17 0 0 0
Unknown purchase
expenses:unknown 11
expenses:groceries || 300
expenses:groceries || 0 0 300 0 0 0 0 0 0 0 0 0
assets:transfer || 23 0 0 0
Later unknown
expenses:unknown 19
assets:cash || -41
assets:cash || -360
expenses:bank-fees

# Owner reports inherit custom account types, with one or several owners.
<
. ./test/shell/setup.sh
owner="Morgan's \$(echo injected)"
mv import/gawie "import/$owner"
sed -e 's/assets/aktiva/' -e 's/expenses/aufwendungen/' import/bogart.rules > custom.rules
mv custom.rules import/bogart.rules
printf '%s\n' 'account aktiva  ; type: A' 'account aufwendungen  ; type: X' > directives.journal
flow import
flow report --ascii-reports
report_row "reports/$owner/2016/income-expenses.txt" aufwendungen:bank-fees | grep -Fx 'aufwendungen:bank-fees || 5' > /dev/null
report_row "reports/$owner/2016/monthly/income-expenses.txt" aufwendungen:bank-fees | grep -Fx 'aufwendungen:bank-fees || 0 0 5 0 0 0 0 0 0 0 0 0' > /dev/null
report_row "reports/$owner/2016/balance-sheet.txt" aktiva:bank | grep -Fx 'aktiva:bank || -5' > /dev/null
other=import/other/bogart/cheque/1-in/2016
mkdir -p "$other"
printf '%s\n' '2016-03-01,Other bank fee,-7' > "$other/march.csv"
flow import
flow report --ascii-reports
report_row "reports/$owner/2016/income-expenses.txt" aufwendungen:bank-fees | grep -Fx 'aufwendungen:bank-fees || 5' > /dev/null
report_row reports/other/2016/income-expenses.txt aufwendungen:bank-fees | grep -Fx 'aufwendungen:bank-fees || 7' > /dev/null
report_row reports/all/2016/income-expenses.txt aufwendungen:bank-fees | grep -Fx 'aufwendungen:bank-fees || 12' > /dev/null
# Normalize native Windows paths before replaying the command in sh.
sed -n '1p' "reports/$owner/2016/income-expenses.txt" | tr -d '\r' | tr '\\' '/' | sh > replay.txt
tail -n +3 "reports/$owner/2016/income-expenses.txt" > original.txt
cmp original.txt replay.txt
$ sh -eu

# Owner reports apply commodity formatting to manual transactions too.
<
. ./test/shell/setup.sh
manual=import/gawie/_manual_/2016
mkdir -p "$manual"
printf '%s\n' '2016-03-02 Market' '    expenses:groceries  UAH1759.71' '    assets:cash' > "$manual/post-import.journal"
printf '%s\n' 'commodity 1,000.00 UAH' > directives.journal
flow import
flow report --ascii-reports
report_row reports/gawie/2016/income-expenses.txt expenses:groceries | grep -Fx 'expenses:groceries || 1,759.71 UAH' > /dev/null
report_row reports/gawie/2016/balance-sheet.txt assets:cash | grep -Fx 'assets:cash || -1,759.71 UAH' > /dev/null
$ sh -eu

# A relative LEDGER_FILE may contain spaces; empty reports remove their stale output.
<
. ./test/shell/setup.sh
flow import
export LEDGER_FILE="selected ledger.journal"
mv all-years.journal "$LEDGER_FILE"
mkdir -p reports/gawie/2016
echo stale > reports/gawie/2016/unknown-transactions.txt
flow report --ascii-reports
test ! -e reports/gawie/2016/unknown-transactions.txt
test -s reports/gawie/2016/accounts.txt
$ sh -eu

# Retiring the last statement for a year preserves its reports while a newer year is reported.
<
. ./test/shell/setup.sh
flow import
flow report --ascii-reports
test -s reports/gawie/2016/income-expenses.txt
cp -R reports/gawie/2016 archived-2016
rm "$inbox/march.csv"
mkdir -p "$account/1-in/2017"
printf '%s\n' '2017-03-01,New year fee,-9' > "$account/1-in/2017/march.csv"
flow import
test ! -e "$journal"
flow report --ascii-reports
diff -r archived-2016 reports/gawie/2016
report_row reports/gawie/2017/income-expenses.txt expenses:bank-fees
$ sh -eu
expenses:bank-fees || 9

# Each owner's accounts report uses the full directory name, including dots.
<
. ./test/shell/setup.sh
junior=import/gawie.jr/bogart/cheque
mkdir -p "$junior/1-in/2016"
cp "$inbox/march.csv" "$junior/1-in/2016/march.csv"
sed 's/bank-fees/junior-fees/' import/bogart.rules > "$junior/bogart-cheque.rules"
flow import
flow report --ascii-reports
grep '^expenses:' reports/gawie/2016/accounts.txt | tr -d '\r'
grep '^expenses:' reports/gawie.jr/2016/accounts.txt | tr -d '\r'
test -s reports/all/2016/income-expenses.txt
test ! -e reports/_all_
$ sh -eu
expenses:bank-fees
expenses:junior-fees

# An owner named All keeps its own report while aggregates use the fallback.
<
. ./test/shell/setup.sh
other=import/All/bogart/cheque
mkdir -p "$other/1-in/2016"
cp "$inbox/march.csv" "$other/1-in/2016/march.csv"
sed 's/bank-fees/owner-fees/' import/bogart.rules > "$other/bogart-cheque.rules"
flow import
flow report --ascii-reports
aggregate=reports/_all_/2016/income-expenses.txt
individual=reports/All/2016/income-expenses.txt
grep -q bank-fees "$aggregate"
grep -q owner-fees "$aggregate"
grep -q owner-fees "$individual"
if grep -q bank-fees "$individual"; then exit 1; fi
$ sh -eu

# Reports discover owners under a linked import directory on Unix and Windows.
<
. ./test/shell/setup.sh
mv import ledger-data
case "$(uname -s)" in
    MINGW*|MSYS*) MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c 'mklink /J import ledger-data' > /dev/null ;;
    *) ln -s ledger-data import ;;
esac
flow import
mkdir import/.hidden import/ignored_
flow report --ascii-reports
test ! -e reports/.hidden
test ! -e reports/ignored_
tr -d '\r' < reports/gawie/2016/accounts.txt | grep -Fx expenses:bank-fees
$ sh -eu
expenses:bank-fees

# An empty unknown-transactions report is counted as skipped.
<
. ./test/shell/setup.sh
flow import
hledger-flow report > summary 2> /dev/null
grep -q '^Generated [0-9]* reports in reports/\. Skipped [1-9][0-9]* empty report' summary
test ! -f reports/gawie/2016/unknown-transactions.txt
$ sh -eu

# Report can open the same home-relative journal that status found.
<
. ./test/shell/setup.sh
case "$(uname -s)" in MINGW*|MSYS*) exit 0 ;; esac
flow import
export HOME="$PWD" LEDGER_FILE='~/all-years.journal'
hledger-flow status --json | jq -e '.ledgerFile.exists and .next.command == "hledger-flow report"' > /dev/null
flow report
test -s reports/gawie/2016/accounts.txt
$ sh -eu

# Root manual transactions reach aggregate financial statements with zero or one owner.
<
. ./test/shell/setup.sh
mv import/gawie owner
manual=import/_manual_/2016
mkdir -p "$manual"
printf '%s\n' '2016-03-02 Train fare' '    expenses:travel  30' '    assets:cash' > "$manual/post-import.journal"
for owners in 0 1; do
    if test "$owners" = 1; then mv owner import/gawie; fi
    flow import
    flow report --ascii-reports
    report_row reports/all/2016/income-expenses.txt expenses:travel
    report_row reports/all/2016/monthly/income-expenses.txt expenses:travel
    report_row reports/all/2016/balance-sheet.txt assets:cash
done
report_row reports/all/2016/income-expenses.txt expenses:bank-fees
report_row reports/gawie/2016/income-expenses.txt expenses:bank-fees
if grep -Fq expenses:travel reports/gawie/2016/income-expenses.txt; then exit 1; fi
$ sh -eu
expenses:travel || 30
expenses:travel || 0 0 30 0 0 0 0 0 0 0 0 0
assets:cash || -30
expenses:travel || 30
expenses:travel || 0 0 30 0 0 0 0 0 0 0 0 0
assets:cash || -30
expenses:bank-fees || 5
expenses:bank-fees || 5

# An owner prepared for future statements does not prevent existing reports.
<
. ./test/shell/setup.sh
mkdir import/nextyear
flow import
flow report --ascii-reports
test ! -d reports/nextyear
report_row reports/gawie/2016/income-expenses.txt expenses:bank-fees
$ sh -eu
expenses:bank-fees || 5
